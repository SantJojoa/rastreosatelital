<section class="py-9 border-y border-[rgba(0,89,166,0.08)]" style="background-color: var(--surface-tint);">
    <div class="container-custom mb-6 flex items-center gap-4 reveal">
        <div class="h-px flex-1 bg-[rgba(0,89,166,0.12)]"></div>
        <p class="text-slate-500 text-sm font-medium shrink-0">Empresas que confían en nosotros</p>
        <div class="h-px flex-1 bg-[rgba(0,89,166,0.12)]"></div>
    </div>

    <div class="relative overflow-hidden">
        <!-- Fade left -->
        <div class="absolute left-0 top-0 h-full w-24 bg-gradient-to-r from-[var(--surface-tint)] to-transparent z-10 pointer-events-none"></div>
        <!-- Fade right -->
        <div class="absolute right-0 top-0 h-full w-24 bg-gradient-to-l from-[var(--surface-tint)] to-transparent z-10 pointer-events-none"></div>

        <div class="logo-track">
            {[
                "empopasto", "montagas", "transipiales", "acar",
                "consorcio", "ecos", "electro", "tax", "tina",
                "empopasto", "montagas", "transipiales", "acar",
                "consorcio", "ecos", "electro", "tax", "tina",
            ].map((name) => (
                <div class="flex items-center justify-center px-8 shrink-0 w-40 h-16">
                    <img
                        src={`/aliados/${name}.png`}
                        alt={name}
                        class="w-full h-full object-contain grayscale hover:grayscale-0 opacity-60 hover:opacity-100 transition-all duration-300"
                    />
                </div>
            ))}
        </div>
    </div>
</section>
