---
const services = [
    {
        slug: "vehiculos-particulares",
        title: "Vehículos Particulares",
        subtitle: "y Motocicletas",
        desc: "Protege tu vehículo o moto con rastreo preciso, alertas de movimiento y recuperación rápida ante robo.",
        accent: "#0059a6",
        light: "#e8f0fb",
        tag: "Más popular",
        features: ["Botón de pánico", "Apagado remoto", "Historial de viajes", "App Android & iOS"],
        image: "/references/moto.jpeg",
    },
    {
        slug: "transporte-de-pasajeros",
        title: "Transporte",
        subtitle: "de Pasajeros",
        desc: "Garantiza la seguridad de tus pasajeros con monitoreo en tiempo real, control de velocidad y módulo FUEC.",
        accent: "#0284c7",
        light: "#e0f2fe",
        tag: "FUEC incluido",
        features: ["Contador de pasajeros", "Módulo FUEC", "Control de velocidad", "Geocercas de ruta"],
        image: "/references/transporte-pasajeros.jpeg",
    },
    {
        slug: "maquinaria-amarilla",
        title: "Maquinaria",
        subtitle: "Amarilla",
        desc: "Controla excavadoras, volquetas y equipos pesados con seguimiento de horas de uso y alertas de inactividad.",
        accent: "#d97706",
        light: "#fef3c7",
        tag: "Sector minero",
        features: ["Horas de trabajo", "Mantenimiento por fecha", "Geocercas de obra", "Consumo de combustible"],
        image: "/references/maquinaria-amarilla.jpeg",
    },
    {
        slug: "transporte-de-hidrocarburos",
        title: "Hidrocarburos",
        subtitle: "y Carga Peligrosa",
        desc: "Monitoreo especializado: control de rutas, paradas autorizadas y sensores de tapas en tiempo real.",
        accent: "#dc2626",
        light: "#fee2e2",
        tag: "Alta seguridad",
        features: ["Sensores de tapas", "Alertas de ruta", "Trazabilidad completa", "Mantenimiento por km"],
        image: "/references/hidro-cargapeligrosa.jpeg",
    },
    {
        slug: "transporte-de-carga",
        title: "Transporte",
        subtitle: "de Carga",
        desc: "Soluciones para refrigerados, contenedores y grúas con sensores de temperatura y candados satelitales.",
        accent: "#7c3aed",
        light: "#ede9fe",
        tag: "Sensor incluido",
        features: ["Sensor de temperatura", "Candado satelital", "Sensor de planchón", "Control de entregas"],
        image: "/references/transporte-carga.jpg",
    },
];
---

<section class="py-16 bg-white">
    <div class="container-custom">
        <div class="mb-10 reveal">
            <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight" style="text-wrap: balance;">
                Soluciones para <span style="color: #0059a6;">cada sector</span>
            </h2>
            <p class="text-slate-500 mt-4 max-w-lg text-base">
                Tecnología adaptada a las necesidades específicas de cada tipo de vehículo y operación.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 reveal-stagger">
            {services.map((s) => (
                <article
                    class="group relative bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col"
                >
                    <!-- Header band with reference photo -->
                    <div
                        class="relative h-44 flex items-end px-8 pb-6 overflow-hidden"
                        style={`background-color: ${s.light};`}
                    >
                        <img
                            src={s.image}
                            alt={`${s.title} ${s.subtitle}`}
                            class="absolute inset-0 w-full h-full object-cover scale-105 group-hover:scale-110 transition-transform duration-500"
                        />
                        <div
                            class="absolute inset-0"
                            style="background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.05) 55%, rgba(0,0,0,0.25) 100%);"
                        >
                        </div>

                        <!-- Tag pill -->
                        {s.tag && (
                            <span
                                class="relative z-10 px-3 py-1 rounded-full text-xs font-bold text-white shadow-md"
                                style={`background-color: ${s.accent};`}
                            >
                                {s.tag}
                            </span>
                        )}

                        <!-- Icon -->
                        <div
                            class="absolute top-5 right-6 z-10 w-11 h-11 rounded-2xl flex items-center justify-center text-white shadow-lg ring-2 ring-white/30"
                            style={`background-color: ${s.accent};`}
                        >
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                            </svg>
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="flex flex-col gap-4 p-8 flex-1">
                        <div>
                            <h3 class="text-xl font-extrabold text-slate-900 leading-tight">
                                {s.title}
                                <span class="block text-base font-semibold mt-0.5" style={`color: ${s.accent};`}>{s.subtitle}</span>
                            </h3>
                            <p class="text-slate-500 text-sm leading-relaxed mt-2">{s.desc}</p>
                        </div>

                        <!-- Features list -->
                        <ul class="grid grid-cols-2 gap-x-4 gap-y-1.5 flex-1">
                            {s.features.map(f => (
                                <li class="flex items-center gap-1.5 text-xs text-slate-600">
                                    <span class="w-1.5 h-1.5 rounded-full shrink-0" style={`background-color: ${s.accent};`}></span>
                                    {f}
                                </li>
                            ))}
                        </ul>

                        <!-- CTA -->
                        <a
                            href={`/servicios/${s.slug}`}
                            class="inline-flex items-center gap-2 font-bold text-sm mt-2 group-hover:gap-3 transition-all duration-200"
                            style={`color: ${s.accent};`}
                        >
                            Ver servicio completo
                            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
                            </svg>
                        </a>
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>
