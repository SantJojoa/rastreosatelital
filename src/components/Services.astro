---
const services = [
    {
        slug: "vehiculos-particulares",
        title: "Vehículos Particulares",
        subtitle: "y Motocicletas",
        desc: "Protege tu vehículo o moto con rastreo preciso, alertas de movimiento y recuperación rápida ante robo.",
        accent: "#0059a6",
        light: "#e8f0fb",
        tag: "Más popular",
        features: ["Botón de pánico", "Apagado remoto", "Historial de viajes", "App Android & iOS"],
        // SVG path de carro
        shape: `<circle cx="160" cy="100" r="80" fill="currentColor" opacity="0.08"/>
                <rect x="40" y="70" width="240" height="80" rx="20" fill="currentColor" opacity="0.15"/>
                <rect x="80" y="50" width="160" height="50" rx="14" fill="currentColor" opacity="0.12"/>
                <circle cx="90" cy="155" r="22" fill="currentColor" opacity="0.25"/>
                <circle cx="230" cy="155" r="22" fill="currentColor" opacity="0.25"/>`,
    },
    {
        slug: "transporte-de-pasajeros",
        title: "Transporte",
        subtitle: "de Pasajeros",
        desc: "Garantiza la seguridad de tus pasajeros con monitoreo en tiempo real, control de velocidad y módulo FUEC.",
        accent: "#0284c7",
        light: "#e0f2fe",
        tag: "FUEC incluido",
        features: ["Contador de pasajeros", "Módulo FUEC", "Control de velocidad", "Geocercas de ruta"],
        shape: `<rect x="30" y="55" width="260" height="100" rx="18" fill="currentColor" opacity="0.15"/>
                <rect x="30" y="55" width="60" height="100" rx="18" fill="currentColor" opacity="0.08"/>
                <rect x="45" y="72" width="35" height="30" rx="5" fill="currentColor" opacity="0.2"/>
                <rect x="95" y="72" width="35" height="30" rx="5" fill="currentColor" opacity="0.2"/>
                <rect x="145" y="72" width="35" height="30" rx="5" fill="currentColor" opacity="0.2"/>
                <rect x="195" y="72" width="35" height="30" rx="5" fill="currentColor" opacity="0.2"/>
                <circle cx="75" cy="160" r="20" fill="currentColor" opacity="0.25"/>
                <circle cx="215" cy="160" r="20" fill="currentColor" opacity="0.25"/>`,
    },
    {
        slug: "maquinaria-amarilla",
        title: "Maquinaria",
        subtitle: "Amarilla",
        desc: "Controla excavadoras, volquetas y equipos pesados con seguimiento de horas de uso y alertas de inactividad.",
        accent: "#d97706",
        light: "#fef3c7",
        tag: "Sector minero",
        features: ["Horas de trabajo", "Mantenimiento por fecha", "Geocercas de obra", "Consumo de combustible"],
        shape: `<rect x="60" y="90" width="200" height="70" rx="10" fill="currentColor" opacity="0.15"/>
                <rect x="180" y="50" width="80" height="70" rx="8" fill="currentColor" opacity="0.12"/>
                <rect x="20" y="110" width="50" height="20" rx="5" fill="currentColor" opacity="0.2"/>
                <rect x="250" y="110" width="50" height="20" rx="5" fill="currentColor" opacity="0.2"/>
                <circle cx="100" cy="165" r="18" fill="currentColor" opacity="0.25"/>
                <circle cx="220" cy="165" r="18" fill="currentColor" opacity="0.25"/>
                <rect x="80" y="45" width="8" height="60" rx="4" fill="currentColor" opacity="0.3"/>
                <rect x="50" y="35" width="45" height="8" rx="4" fill="currentColor" opacity="0.3"/>`,
    },
    {
        slug: "transporte-de-hidrocarburos",
        title: "Hidrocarburos",
        subtitle: "y Carga Peligrosa",
