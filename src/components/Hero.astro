<section class="relative bg-white overflow-hidden">
    <!-- Decorative background: soft dot grid + blue glow, kept subtle on white -->
    <div class="absolute inset-0 dot-grid opacity-60 pointer-events-none"></div>
    <div
        class="absolute -top-32 -right-32 w-[520px] h-[520px] rounded-full blur-3xl pointer-events-none"
        style="background-color: rgba(0,89,166,0.07);"
    >
    </div>
    <img
        src="/hero-bg_2.jpg"
        alt=""
        class="hidden lg:block absolute right-0 top-0 h-full w-[42%] object-cover pointer-events-none"
        style="mask-image: linear-gradient(to right, transparent, black 35%); -webkit-mask-image: linear-gradient(to right, transparent, black 35%);"
    />

    <div class="container-custom relative z-10 py-10 md:py-12 lg:py-10">
        <div
            class="flex flex-col gap-5 reveal is-visible max-w-5xl"
            style="transition-delay:200ms"
        >
            <h1
                class="text-3xl md:text-4xl xl:text-5xl font-extrabold leading-[1.08] tracking-tight"
            >
                <span style="color: #0059a6;">
                    <span id="typewriter-line1"></span>
                </span>
                <span class="text-slate-900">
                    <span id="typewriter-line2"></span>
                </span>
            </h1>

            <p
                class="text-slate-600 text-base md:text-lg leading-relaxed max-w-xl"
            >
                Soluciones de rastreo satelital, monitoreo y seguridad para
                optimizar la gestión de su flota y lo que más importa.
            </p>

            <!-- 4 feature highlights -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 py-1">
                {
                    [
                        {
                            label: "Monitoreo en tiempo real",
                            icon: "M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z",
                        },
                        {
                            label: "Seguridad y confiabilidad",
                            icon: "M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z",
                        },
                        {
                            label: "Reportes inteligentes",
                            icon: "M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z",
                        },
                        {
                            label: "Soluciones a la medida",
                            icon: "M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75",
                        },
                    ].map((item) => (
                        <div class="flex flex-col gap-2">
                            <div
                                class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0"
                                style="background-color: rgba(0,89,166,0.08); color: #0059a6;"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke-width="1.5"
                                    stroke="currentColor"
                                    aria-hidden="true"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d={item.icon}
                                    />
                                </svg>
                            </div>
                            <span class="text-sm font-semibold text-slate-700 leading-snug">
                                {item.label}
                            </span>
                        </div>
                    ))
                }
            </div>

            <!-- Two platform cards -->
            <div class="grid sm:grid-cols-2 gap-4 items-stretch">
                <!-- Plataforma completa: highlighted -->
                <a
                    href="/planes"
                    class="platform-glow group relative rounded-3xl p-5 flex flex-col gap-3 overflow-hidden transition-transform duration-300 hover:-translate-y-1.5 shadow-xl"
                    style="background-color: #0059a6;"
                >
                    <div
                        class="w-10 h-10 rounded-2xl bg-white/15 border border-white/25 flex items-center justify-center text-white group-hover:scale-110 transition-transform duration-300"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            aria-hidden="true"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"
                            ></path>
                        </svg>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <h3 class="text-lg font-bold text-white">
                            Plataforma completa
                        </h3>
                        <p class="text-blue-100 text-sm leading-relaxed">
                            Solución robusta con gestión avanzada de flotas,
                            control de tráfico, reportes completos, cumplimiento
                            RNDC y PESV, y mucho más.
                        </p>
                    </div>
                    <span
                        class="mt-auto inline-flex items-center justify-center gap-1.5 text-sm font-bold px-5 py-2 rounded-full self-start group-hover:gap-2.5 transition-all duration-200"
                        style="background-color: #ffd400; color: #003d73;"
                    >
                        Ingresar
                        <svg
                            class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 20 20"
                            fill="currentColor"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                                clip-rule="evenodd"></path>
                        </svg>
                    </span>
                </a>

                <!-- Plataforma básica -->
                <a
                    href="/planes"
                    class="group relative rounded-3xl p-7 flex flex-col gap-4 border-2 border-slate-200 hover:border-[#0059a6]/40 hover:shadow-lg transition-all duration-300"
                >
                    <div
                        class="w-12 h-12 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
                        style="background-color: rgba(0,89,166,0.08); color: #0059a6;"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            aria-hidden="true"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"
                            ></path>
                        </svg>
                    </div>
                    <div class="flex flex-col gap-2">
                        <h3 class="text-xl font-bold text-slate-900">
                            Plataforma básica
                        </h3>
                        <p class="text-slate-500 text-sm leading-relaxed">
                            Solución simple y eficiente: monitoreo esencial de
                            vehículos en tiempo real, históricos, alertas y
                            geocercas.
                        </p>
                    </div>
                    <span
                        class="mt-auto inline-flex items-center gap-1.5 text-sm font-semibold"
                        style="color: #0059a6;"
                    >
                        Ingresar
                        <svg
                            class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 20 20"
                            fill="currentColor"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                                clip-rule="evenodd"></path>
                        </svg>
                    </span>
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .platform-glow {
        animation: glow-pulse 2.4s ease-in-out infinite;
    }

    @keyframes glow-pulse {
        0%,
        100% {
            box-shadow: 0 20px 40px -12px rgba(0, 89, 166, 0.35);
        }
        50% {
            box-shadow: 0 20px 46px -10px rgba(0, 89, 166, 0.6);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .platform-glow {
            animation: none;
        }
    }
</style>

<script>
    const line1 = "TECNOLOGÍA QUE CONECTA";
    const line2 = "CONTROL QUE TRANSFORMA";

    const el1 = document.getElementById("typewriter-line1")!;
    const el2 = document.getElementById("typewriter-line2")!;

    let i = 0;

    function typeLine1() {
        if (i <= line1.length) {
            el1.textContent = line1.slice(0, i);
            i++;
            setTimeout(typeLine1, i < 10 ? 70 : 45);
        } else {
            i = 0;
            setTimeout(typeLine2, 150);
        }
    }

    function typeLine2() {
        if (i <= line2.length) {
            el2.textContent = line2.slice(0, i);
            i++;
            setTimeout(typeLine2, i < 10 ? 70 : 45);
        }
    }

    typeLine1();
</script>
