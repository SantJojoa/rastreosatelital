<section class="relative min-h-screen flex items-center bg-slate-950 overflow-hidden">
    <!-- BG image -->
    <img src="/hero-bg2.png" alt="" class="absolute inset-0 w-full h-full object-cover opacity-60" />
    <!-- Gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/90 to-slate-950/70"></div>
    <!-- Glow accent -->
    <div class="absolute top-1/3 left-1/4 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container-custom relative z-10 grid lg:grid-cols-2 gap-16 items-center py-24">
        <!-- Left -->
        <div class="flex flex-col gap-6">
            <span class="inline-flex items-center gap-2 self-start px-4 py-1.5 rounded-full bg-blue-500/15 border border-blue-400/30 text-blue-300 text-sm font-medium tracking-wide">
                <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
                Tecnología Satelital 24/7
            </span>

            <h1 class="text-5xl md:text-6xl xl:text-7xl font-extrabold text-white leading-[1.1] tracking-tight">
                <span id="typewriter-text"></span><span id="typewriter-cursor" class="inline-block w-[3px] h-[0.9em] bg-blue-400 align-middle ml-1 animate-pulse"></span>
            </h1>

            <p class="text-slate-300 text-lg leading-relaxed max-w-lg">
                Aprovecha las mejores herramientas tecnológicas para la administración remota de flotas vehiculares.
            </p>

            <div class="flex flex-wrap gap-4 mt-2">
                <a href="#" class="inline-flex items-center gap-2 px-7 py-3.5 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-full transition-colors duration-200">
                    Solicitar Demo
                    <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
                    </svg>
                </a>
                <a href="#" class="inline-flex items-center gap-2 px-7 py-3.5 border border-white/20 hover:border-white/40 bg-white/5 hover:bg-white/10 text-white font-semibold rounded-full transition-all duration-200">
                    Escríbenos Ahora
                </a>
            </div>

        </div>

        <!-- Right: floating car -->
        <div class="hidden lg:flex justify-center items-center">
            <div class="relative">
                <div class="absolute inset-0 bg-blue-500/20 rounded-full blur-3xl scale-110"></div>
                <img src="/car2.png" alt="Vehículo" class="relative w-full max-w-lg animate-float drop-shadow-2xl" />
            </div>
        </div>
    </div>
</section>

<script>
    const fullText = "Trabajamos para tu Seguridad y Tranquilidad";
    const coloredWords = ["Seguridad", "Tranquilidad"];
    const el = document.getElementById("typewriter-text")!;
    const cursor = document.getElementById("typewriter-cursor")!;

    let i = 0;

    function renderText(text: string) {
        let result = "";
        let remaining = text;
        for (const word of coloredWords) {
            const idx = remaining.indexOf(word);
            if (idx !== -1) {
                result += remaining.slice(0, idx);
                result += `<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-400">${word}</span>`;
                remaining = remaining.slice(idx + word.length);
            }
        }
        result += remaining;
        el.innerHTML = result;
    }

    function type() {
        if (i <= fullText.length) {
            renderText(fullText.slice(0, i));
            i++;
            setTimeout(type, i < 10 ? 80 : 55);
        } else {
            // hide cursor after done
            setTimeout(() => cursor.style.opacity = "0", 1200);
        }
    }

    type();
</script>
