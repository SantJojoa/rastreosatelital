---
import { SERVICES } from "../data/services";
---

<section class="relative bg-white overflow-hidden">
    <!-- Decorative background: soft dot grid + blue glow, kept subtle on white -->
    <div class="absolute inset-0 dot-grid opacity-60 pointer-events-none"></div>
    <div
        class="absolute -top-32 -right-32 w-[520px] h-[520px] rounded-full blur-3xl pointer-events-none"
        style="background-color: rgba(0,89,166,0.07);"
    >
    </div>
    <img
        src="/fondo_final.png"
        alt=""
        class="hidden lg:block absolute right-0 top-0 h-full w-[55%] object-cover pointer-events-none"
        style="mask-image: linear-gradient(to right, transparent, black 35%); -webkit-mask-image: linear-gradient(to right, transparent, black 35%);"
    />

    <div class="container-custom relative z-10 pt-8 pb-6 md:pt-10 md:pb-8 lg:pt-8 lg:pb-6">
        <div
            class="flex flex-col gap-3 reveal is-visible max-w-5xl"
            style="transition-delay:200ms"
        >
            <h1
                class="text-2xl md:text-3xl xl:text-4xl font-extrabold leading-[1.08] tracking-tight"
            >
                <span style="color: #0059a6;">
                    <span id="typewriter-line1"></span>
                </span>
                <span class="text-slate-900">
                    <span id="typewriter-line2"></span>
                </span>
            </h1>

            <p
                class="text-slate-600 text-sm md:text-base leading-relaxed max-w-xl"
            >
                Soluciones de rastreo satelital, monitoreo y seguridad para
                optimizar la gestión de su flota y lo que más importa.
            </p>

            <div class="reveal is-visible" style="transition-delay:300ms">
                <div
                    id="hero-carousel"
                    class="relative w-full h-[160px] sm:h-[220px] lg:h-[260px] rounded-2xl overflow-hidden shadow-xl"
                >
                    {
                        SERVICES.map((service, i) => (
                            <a
                                href={`/servicios/${service.slug}`}
                                class="hero-carousel-slide absolute inset-0 transition-opacity duration-700"
                                style={`opacity:${i === 0 ? 1 : 0}`}
                                data-index={i}
                            >
                                <img
                                    src={service.image}
                                    alt={`${service.title} ${service.subtitle}`}
                                    class="absolute inset-0 w-full h-full object-cover"
                                />
                                <div
                                    class="absolute inset-0"
                                    style="background: linear-gradient(to right, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.55) 32%, rgba(0,0,0,0.1) 62%, rgba(0,0,0,0.05) 100%);"
                                />
                                <div class="relative z-10 h-full flex flex-col justify-center gap-1.5 sm:gap-2 px-4 sm:px-6 lg:px-8 max-w-xl text-white">
                                    {service.tag && (
                                        <span
                                            class="inline-flex self-start px-2.5 py-0.5 rounded-full text-[10px] sm:text-xs font-bold text-white shadow-md"
                                            style={`background-color: ${service.accent};`}
                                        >
                                            {service.tag}
                                        </span>
                                    )}
                                    <h3 class="text-base sm:text-xl lg:text-2xl font-extrabold leading-tight">
                                        {service.title}
                                        <span class="block text-xs sm:text-sm font-semibold opacity-90 mt-0.5">
                                            {service.subtitle}
                                        </span>
                                    </h3>
                                    <p class="hidden lg:block text-xs text-white/85 leading-relaxed max-w-md line-clamp-2">
                                        {service.description}
                                    </p>
                                    <span class="inline-flex items-center gap-1.5 font-bold text-xs sm:text-sm mt-0.5">
                                        Ver servicio
                                        <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
                                        </svg>
                                    </span>
                                </div>
                            </a>
                        ))
                    }

                    <div class="absolute bottom-2 sm:bottom-3 inset-x-0 z-10 flex justify-center gap-1.5">
                        {
                            SERVICES.map((_, i) => (
                                <button
                                    type="button"
                                    class="hero-carousel-dot w-1.5 h-1.5 rounded-full transition-colors duration-200"
                                    style={`background-color: rgba(255,255,255,${i === 0 ? 1 : 0.4});`}
                                    data-index={i}
                                    aria-label={`Ver servicio ${i + 1}`}
                                />
                            ))
                        }
                    </div>
                </div>
            </div>

            <!-- Three main CTA cards -->
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 items-stretch">
                <!-- Rastreo Vehicular GPS: highlighted -->
                <a
                    href="/planes"
                    class="platform-glow group relative rounded-2xl p-3.5 flex flex-col gap-2 overflow-hidden transition-transform duration-300 hover:-translate-y-1 shadow-lg"
                    style="background-color: #0059a6;"
                >
                    <div
                        class="w-8 h-8 rounded-xl bg-white/15 border border-white/25 flex items-center justify-center text-white group-hover:scale-110 transition-transform duration-300"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            aria-hidden="true"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                            ></path>
                        </svg>
                    </div>
                    <div class="flex flex-col gap-1">
                        <h3 class="text-sm font-bold text-white">
                            Rastreo Vehicular GPS
                        </h3>
                        <p class="text-blue-100 text-xs leading-relaxed line-clamp-2">
                            Monitorea tu flota en tiempo real, controla rutas y
                            protege tus vehículos con la plataforma líder en
                            rastreo satelital.
                        </p>
                    </div>
                    <span
                        class="mt-auto inline-flex items-center justify-center gap-1 text-xs font-bold px-3.5 py-1.5 rounded-full self-start group-hover:gap-2 transition-all duration-200"
                        style="background-color: #ffd400; color: #003d73;"
                    >
                        Ver planes
                        <svg
                            class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform duration-200"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 20 20"
                            fill="currentColor"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                                clip-rule="evenodd"></path>
                        </svg>
                    </span>
                </a>

                <!-- Cámaras de Seguridad -->
                <a
                    href="/camaras"
                    class="group relative rounded-2xl p-3.5 flex flex-col gap-2 border-2 border-[rgba(0,89,166,0.14)] hover:border-[rgba(0,89,166,0.4)] hover:shadow-lg transition-all duration-300"
                    style="background-color: var(--surface-tint);"
                >
                    <div
                        class="w-8 h-8 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
                        style="background-color: rgba(0,89,166,0.08); color: #0059a6;"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            aria-hidden="true"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z"
                            ></path>
                        </svg>
                    </div>
                    <div class="flex flex-col gap-1">
                        <h3 class="text-sm font-bold text-slate-900">
                            Cámaras de Seguridad
                        </h3>
                        <p class="text-slate-500 text-xs leading-relaxed line-clamp-2">
                            Vigilancia inteligente para tu vehículo, negocio o
                            vivienda con tecnología de última generación.
                        </p>
                    </div>
                    <span
                        class="mt-auto inline-flex items-center gap-1 text-xs font-semibold"
                        style="color: #0059a6;"
                    >
                        Conocer más
                        <svg
                            class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform duration-200"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 20 20"
                            fill="currentColor"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                                clip-rule="evenodd"></path>
                        </svg>
                    </span>
                </a>

                <!-- Seguros -->
                <a
                    href="/seguros"
                    class="group relative rounded-2xl p-3.5 flex flex-col gap-2 border-2 border-[rgba(0,89,166,0.14)] hover:border-[rgba(0,89,166,0.4)] hover:shadow-lg transition-all duration-300"
                    style="background-color: var(--surface-tint);"
                >
                    <div
                        class="w-8 h-8 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
                        style="background-color: rgba(0,89,166,0.08); color: #0059a6;"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            aria-hidden="true"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 3l7.5 3v5.25c0 4.9-3.2 8.99-7.5 10.5-4.3-1.51-7.5-5.6-7.5-10.5V6l7.5-3z"
                            ></path>
                        </svg>
                    </div>
                    <div class="flex flex-col gap-1">
                        <h3 class="text-sm font-bold text-slate-900">
                            Seguros
                        </h3>
                        <p class="text-slate-500 text-xs leading-relaxed line-clamp-2">
                            Cotiza pólizas de seguros para tu vehículo y
                            protege tu inversión ante cualquier eventualidad.
                        </p>
                    </div>
                    <span
                        class="mt-auto inline-flex items-center gap-1 text-xs font-semibold"
                        style="color: #0059a6;"
                    >
                        Conocer más
                        <svg
                            class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform duration-200"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 20 20"
                            fill="currentColor"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                                clip-rule="evenodd"></path>
                        </svg>
                    </span>
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .platform-glow {
        animation: glow-pulse 2.4s ease-in-out infinite;
    }

    @keyframes glow-pulse {
        0%,
        100% {
            box-shadow: 0 20px 40px -12px rgba(0, 89, 166, 0.35);
        }
        50% {
            box-shadow: 0 20px 46px -10px rgba(0, 89, 166, 0.6);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .platform-glow {
            animation: none;
        }
    }
</style>

<script>
    const line1 = "TECNOLOGÍA QUE CONECTA";
    const line2 = "CONTROL QUE TRANSFORMA";

    const el1 = document.getElementById("typewriter-line1")!;
    const el2 = document.getElementById("typewriter-line2")!;

    let i = 0;

    function typeLine1() {
        if (i <= line1.length) {
            el1.textContent = line1.slice(0, i);
            i++;
            setTimeout(typeLine1, i < 10 ? 70 : 45);
        } else {
            i = 0;
            setTimeout(typeLine2, 150);
        }
    }

    function typeLine2() {
        if (i <= line2.length) {
            el2.textContent = line2.slice(0, i);
            i++;
            setTimeout(typeLine2, i < 10 ? 70 : 45);
        }
    }

    typeLine1();
</script>

<script>
    const slides = document.querySelectorAll<HTMLAnchorElement>(
        "#hero-carousel .hero-carousel-slide",
    );
    const dots = document.querySelectorAll<HTMLButtonElement>(
        "#hero-carousel .hero-carousel-dot",
    );
    let current = 0;
    let timer: ReturnType<typeof setInterval>;

    function showSlide(index: number) {
        slides.forEach((slide, i) => {
            slide.style.opacity = i === index ? "1" : "0";
            slide.style.pointerEvents = i === index ? "auto" : "none";
        });
        dots.forEach((dot, i) => {
            dot.style.backgroundColor = `rgba(255,255,255,${i === index ? 1 : 0.4})`;
        });
        current = index;
    }

    function next() {
        showSlide((current + 1) % slides.length);
    }

    function restartTimer() {
        clearInterval(timer);
        timer = setInterval(next, 3000);
    }

    dots.forEach((dot, i) => {
        dot.addEventListener("click", (e) => {
            e.preventDefault();
            showSlide(i);
            restartTimer();
        });
    });

    if (slides.length > 1) {
        restartTimer();
    }
</script>
