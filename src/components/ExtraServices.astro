<section class="py-24 bg-white">
    <div class="container-custom">
        <div class="mb-14">
            <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight">
                Seguridad <span class="text-blue-600">integral</span>
            </h2>
            <p class="text-slate-500 mt-3 max-w-lg">
                Más allá del rastreo, un ecosistema completo de seguridad para tu vehículo y tu hogar.
            </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">

            <!-- Cámaras vehiculares -->
            <article class="group relative bg-slate-900 rounded-3xl p-8 overflow-hidden flex flex-col gap-6 hover:-translate-y-1 hover:shadow-2xl transition-all duration-300">
                <!-- Glow -->
                <div class="absolute top-0 right-0 w-48 h-48 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>

                <div class="relative z-10">
                    <div class="w-14 h-14 rounded-2xl bg-blue-600 flex items-center justify-center text-white shadow-[0_4px_14px_rgba(29,78,216,0.4)] mb-6 group-hover:scale-110 transition-transform duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z" />
                        </svg>
                    </div>

                    <h3 class="text-xl font-bold text-white mb-1">Cámaras</h3>
                    <p class="text-blue-400 font-semibold text-sm mb-6">Vehiculares</p>

                    <ul class="flex flex-col gap-3">
                        {[
                            "Reconocimiento de rostro",
                            "Full HD",
                            "Visión nocturna",
                            "Grabación hasta 3 meses",
                            "Memoria SD hasta 256 GB",
                            "Transmisión en línea via WiFi",
                            "Reproducción desde APP o PC",
                        ].map((item) => (
                            <li class="flex items-start gap-2.5 text-slate-300 text-sm">
                                <span class="mt-0.5 w-4 h-4 rounded-full bg-blue-500/20 border border-blue-500/40 flex items-center justify-center shrink-0">
                                    <svg class="w-2.5 h-2.5 text-blue-400" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </span>
                                {item}
                            </li>
                        ))}
                    </ul>
                </div>

                <a href="#" class="relative z-10 mt-auto inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold transition-colors duration-200 self-start">
                    Solicitar info
                    <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/></svg>
                </a>
            </article>

            <!-- Cámaras residenciales -->
            <article class="group relative bg-slate-900 rounded-3xl p-8 overflow-hidden flex flex-col gap-6 hover:-translate-y-1 hover:shadow-2xl transition-all duration-300">
                <!-- Glow -->
                <div class="absolute top-0 right-0 w-48 h-48 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>

                <div class="relative z-10">
                    <div class="w-14 h-14 rounded-2xl bg-indigo-600 flex items-center justify-center text-white shadow-[0_4px_14px_rgba(99,102,241,0.4)] mb-6 group-hover:scale-110 transition-transform duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                        </svg>
                    </div>

                    <h3 class="text-xl font-bold text-white mb-1">Cámaras</h3>
                    <p class="text-indigo-400 font-semibold text-sm mb-6">Residenciales</p>

                    <ul class="flex flex-col gap-3">
                        {[
                            "Detección de personas con IA",
                            "Luz estroboscópica",
                            "Audio doble vía",
                            "Alarma por detección de rostro",
                            "Memoria SD hasta 256 GB",
                            "Alarma inteligente con IA",
                            "Zona de alerta personalizada",
                            "Visión nocturna a color",
                            "Cámaras PTZ, 360° y 180°",
                        ].map((item) => (
                            <li class="flex items-start gap-2.5 text-slate-300 text-sm">
                                <span class="mt-0.5 w-4 h-4 rounded-full bg-indigo-500/20 border border-indigo-500/40 flex items-center justify-center shrink-0">
                                    <svg class="w-2.5 h-2.5 text-indigo-400" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </span>
                                {item}
                            </li>
                        ))}
                    </ul>
                </div>

                <a href="#" class="relative z-10 mt-auto inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold transition-colors duration-200 self-start">
                    Solicitar info
                    <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/></svg>
                </a>
            </article>

            <!-- Chip de seguridad -->
            <article class="group relative rounded-3xl p-8 overflow-hidden flex flex-col gap-6 hover:-translate-y-1 hover:shadow-2xl transition-all duration-300 bg-gradient-to-br from-blue-700 via-blue-600 to-cyan-500">
                <!-- Decorative circles -->
                <div class="absolute -top-10 -right-10 w-56 h-56 bg-white/10 rounded-full pointer-events-none"></div>
                <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-white/5 rounded-full pointer-events-none"></div>

                <div class="relative z-10">
                    <div class="w-14 h-14 rounded-2xl bg-white/20 border border-white/30 flex items-center justify-center text-white mb-6 group-hover:scale-110 transition-transform duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                        </svg>
                    </div>

                    <h3 class="text-xl font-bold text-white mb-1">Chip de Seguridad</h3>
                    <p class="text-white/70 font-semibold text-sm mb-6">Por alejamiento</p>

                    <div class="flex flex-col gap-4 mb-6">
                        <div class="bg-white/10 border border-white/20 rounded-2xl p-4 flex items-start gap-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                            </svg>
                            <p class="text-white/90 text-sm leading-relaxed">Apaga tu vehículo <strong class="text-white">automáticamente</strong> en caso de hurto mediante señal de alejamiento.</p>
                        </div>
                        <div class="bg-white/10 border border-white/20 rounded-2xl p-4 flex items-start gap-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75" />
                            </svg>
                            <p class="text-white/90 text-sm leading-relaxed"><strong class="text-white">Solución en un solo pago.</strong> Sin mensualidades ni suscripciones adicionales.</p>
                        </div>
                    </div>

                    <div class="flex items-center gap-2 text-white/60 text-xs">
                        <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
                        Instalación profesional incluida
                    </div>
                </div>

                <a href="#" class="relative z-10 mt-auto inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white text-blue-700 text-sm font-bold hover:bg-blue-50 transition-colors duration-200 self-start shadow-lg">
                    Solicitar info
                    <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/></svg>
                </a>
            </article>

        </div>
    </div>
</section>
