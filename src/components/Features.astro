<section class="py-24 bg-white dot-grid">
    <div class="container-custom">
        <div class="mb-14 reveal">
            <p class="text-blue-600 text-sm font-semibold tracking-widest uppercase mb-3">Plataforma</p>
            <h2
                class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight max-w-xl"
            >
                Todo lo que necesitas en
                <span class="text-blue-600"> un solo lugar</span>
            </h2>
        </div>

        <!-- Bento 3×2: 6 celdas, sin huecos -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 reveal-stagger">

            <!-- Card grande: Rastreo en tiempo real (col-span-1 lg, row-span-2) -->
            <article
                class="group relative bg-slate-900 rounded-3xl p-9 overflow-hidden flex flex-col gap-5 lg:row-span-2"
            >
                <div class="absolute top-0 right-0 w-48 h-48 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
                <div class="relative z-10 w-12 h-12 rounded-2xl bg-blue-600 flex items-center justify-center text-white group-hover:scale-110 transition-transform duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"></path>
                    </svg>
                </div>
                <div class="relative z-10 flex flex-col gap-3 flex-1">
                    <h3 class="text-2xl font-bold text-white">Rastreo en Tiempo Real</h3>
                    <p class="text-slate-300 leading-relaxed">
                        Ubica de manera fácil e inmediata tus vehículos mediante el rastreo en tiempo real y de manera ininterrumpida. Sin puntos ciegos, sin demoras.
                    </p>
                </div>
                <div class="relative z-10 flex items-center gap-2 mt-auto">
                    <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
                    <span class="text-slate-400 text-xs">Actualización cada 30 segundos</span>
                </div>
            </article>

            <!-- Card 2: Supervisión de Combustible -->
            <article class="group bg-slate-50 border border-slate-100 rounded-3xl p-8 flex flex-col gap-5 hover:bg-white hover:shadow-lg transition-all duration-300">
                <div class="w-12 h-12 rounded-2xl bg-blue-600 flex items-center justify-center text-white group-hover:scale-110 transition-transform duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6"></path>
                    </svg>
                </div>
                <div class="flex flex-col gap-2 flex-1">
                    <h3 class="text-lg font-bold text-slate-900">Supervisión de Combustible</h3>
                    <p class="text-slate-500 text-sm leading-relaxed">Mantente al tanto del consumo y mantenimiento con análisis del comportamiento de conducción.</p>
                </div>
            </article>

            <!-- Card 3: Optimización de Rutas -->
            <article class="group bg-slate-50 border border-slate-100 rounded-3xl p-8 flex flex-col gap-5 hover:bg-white hover:shadow-lg transition-all duration-300">
                <div class="w-12 h-12 rounded-2xl bg-blue-600 flex items-center justify-center text-white group-hover:scale-110 transition-transform duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"></path>
                    </svg>
                </div>
                <div class="flex flex-col gap-2 flex-1">
                    <h3 class="text-lg font-bold text-slate-900">Optimización de Rutas</h3>
                    <p class="text-slate-500 text-sm leading-relaxed">Disminuye tiempos de conducción con rutas personalizadas e información de tráfico en tiempo real.</p>
                </div>
            </article>

            <!-- Card 4: Alertas en tiempo real -->
            <article class="group bg-blue-600 rounded-3xl p-8 flex flex-col gap-5 hover:-translate-y-1 hover:shadow-xl hover:shadow-blue-600/20 transition-all duration-300">
                <div class="w-12 h-12 rounded-2xl bg-white/15 border border-white/25 flex items-center justify-center text-white group-hover:scale-110 transition-transform duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                    </svg>
                </div>
                <div class="flex flex-col gap-2 flex-1">
                    <h3 class="text-lg font-bold text-white">Alertas en Tiempo Real</h3>
                    <p class="text-blue-100 text-sm leading-relaxed">Notificaciones instantáneas por exceso de velocidad, salida de zona asignada o apertura de puertas no autorizada.</p>
                </div>
            </article>

            <!-- Card 5: Historial de recorridos -->
            <article class="group bg-slate-50 border border-slate-100 rounded-3xl p-8 flex flex-col gap-5 hover:bg-white hover:shadow-lg transition-all duration-300">
                <div class="w-12 h-12 rounded-2xl bg-blue-600 flex items-center justify-center text-white group-hover:scale-110 transition-transform duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3M12 3v9.75" />
                    </svg>
                </div>
                <div class="flex flex-col gap-2 flex-1">
                    <h3 class="text-lg font-bold text-slate-900">Historial de Recorridos</h3>
                    <p class="text-slate-500 text-sm leading-relaxed">Consulta rutas anteriores, tiempos de parada, kilómetros recorridos y comportamiento del conductor desde APP y PC.</p>
                </div>
            </article>

        </div>
    </div>
</section>
