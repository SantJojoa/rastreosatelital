const items = [...equipment, ...equipment];
---

<section class="py-14 bg-white border-y border-slate-100 overflow-hidden">
    <div class="container-custom mb-8">
        <p class="text-center text-slate-500 text-sm font-medium">Equipos que rastreamos</p>
    </div>

    <div class="relative">
        <div class="absolute left-0 top-0 h-full w-24 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"></div>
        <div class="absolute right-0 top-0 h-full w-24 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"></div>

        <div class="equip-track flex gap-5">
            {items.map((item) => (
                <a
                    href={item.href}
                    class="group shrink-0 flex items-center gap-3 border-2 border-slate-100 hover:border-[#0059a6] rounded-2xl px-5 py-3.5 transition-colors duration-200"
                >
                    <div class="w-9 h-9 rounded-xl bg-slate-100 group-hover:bg-[#0059a6] flex items-center justify-center shrink-0 transition-colors duration-200">
                        <svg class="w-4.5 h-4.5 text-[#0059a6] group-hover:text-white transition-colors duration-200" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                        </svg>
                    </div>
                    <span class="text-slate-700 group-hover:text-[#0059a6] font-medium text-sm whitespace-nowrap transition-colors duration-200">{item.name}</span>
                </a>
            ))}
        </div>
    </div>
</section>

<style>
    .equip-track {
        display: flex;
        width: max-content;
        animation: scrollEquip 25s linear infinite;
    }

    @keyframes scrollEquip {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }

    @media (prefers-reduced-motion: reduce) {
        .equip-track { animation: none; }
    }
</style>
