<header
    id="main-header"
    class="sticky top-0 z-50 w-full bg-white/85 backdrop-blur-lg border-b border-black/6 transition-all duration-300"
>
    <div
        id="header-inner"
        class="max-w-360 mx-auto px-8 h-20 flex items-center justify-between transition-all duration-300"
    >
        <!-- Logo -->
        <a href="/" class="flex items-center shrink-0">
            <img
                id="header-logo"
                src="/logo.png"
                alt="Sistemas Virtuales"
                class="h-16 max-w-56 w-auto object-contain object-left transition-all duration-300"
            />
        </a>

        <!-- Nav -->
        <nav class="hidden md:flex items-center gap-10">
            <a href="/" class="nav-link">Inicio</a>

            <!-- Servicios dropdown -->
            <div class="relative" id="services-menu">
                <button
                    id="services-trigger"
                    aria-haspopup="true"
                    aria-expanded="false"
                    class="nav-link flex items-center gap-1 bg-transparent border-0 p-0 cursor-pointer"
                >
                    Servicios
                    <svg id="services-chevron" class="w-3.5 h-3.5 text-slate-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                </button>

                <!-- Dropdown panel -->
                <div
                    id="services-dropdown"
                    role="menu"
                    class="absolute left-0 top-[calc(100%+12px)] w-72 bg-white border border-slate-100 rounded-2xl shadow-xl shadow-slate-200/60 py-2 opacity-0 pointer-events-none transition-all duration-150 origin-top"
                >
                    <!-- Decorative arrow -->
                    <div class="absolute -top-1.5 left-6 w-3 h-3 bg-white border-l border-t border-slate-100 rotate-45"></div>

                    {[
                        { label: "Vehículos Particulares y Motocicletas", slug: "vehiculos-particulares", icon: "M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" },
                        { label: "Transporte de Pasajeros", slug: "transporte-de-pasajeros", icon: "M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" },
                        { label: "Transporte de Hidrocarburos", slug: "transporte-de-hidrocarburos", icon: "M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925 3.546 5.974 5.974 0 01-2.133-1A3.75 3.75 0 0012 18z" },
                        { label: "Maquinaria Amarilla", slug: "maquinaria-amarilla", icon: "M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z" },
                        { label: "Transporte de Carga", slug: "transporte-de-carga", icon: "M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" },
                    ].map((item) => (
                        <a
                            href={`/servicios/${item.slug}`}
                            role="menuitem"
                            class="flex items-center gap-3 px-4 py-2.5 mx-1 rounded-xl text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-700 transition-colors duration-150 group"
                        >
                            <span class="w-7 h-7 rounded-lg bg-slate-100 group-hover:bg-blue-100 flex items-center justify-center shrink-0 transition-colors duration-150">
                                <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                                </svg>
                            </span>
                            {item.label}
                        </a>
                    ))}
                </div>
            </div>

            <a href="/nosotros" class="nav-link">Nosotros</a>
            <a href="#planes" class="nav-link">Planes</a>
        </nav>

        <!-- CTA -->
        <a
            href="https://wa.me/573157003022"
            target="_blank"
            rel="noopener"
            id="cta-btn"
            class="inline-flex items-center gap-2 px-6 py-2.5 bg-gradient-to-br from-blue-700 to-blue-500 text-white text-sm font-semibold rounded-full shadow-[0_4px_14px_rgba(29,78,216,0.35)] hover:shadow-[0_8px_24px_rgba(29,78,216,0.45)] hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 whitespace-nowrap"
        >
            <span>Solicitar Demo</span>
            <svg
                class="w-4 h-4 shrink-0"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
            >
                <path
                    fill-rule="evenodd"
                    d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                    clip-rule="evenodd"></path>
            </svg>
        </a>
    </div>
</header>

<style>
    .nav-link {
        position: relative;
        font-size: 0.95rem;
        font-weight: 500;
        color: #374151;
        text-decoration: none;
        letter-spacing: 0.01em;
        padding-bottom: 4px;
        transition: color 0.2s ease;
    }

    .nav-link::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: 0;
        width: 0;
        height: 2px;
        background: linear-gradient(90deg, #1d4ed8, #3b82f6);
        border-radius: 9999px;
        transition:
            width 0.28s ease,
            left 0.28s ease;
    }

    .nav-link:hover {
        color: #1d4ed8;
    }

    .nav-link:hover::after {
        left: 0;
        width: 100%;
    }

    /* button reset para el trigger */
    #services-trigger {
        font-family: inherit;
    }

    #services-dropdown {
        transform: translateY(-6px);
        transition: opacity 150ms ease, transform 150ms ease;
    }

    /* Puente invisible que cubre el gap entre el trigger y el panel */
    #services-dropdown::before {
        content: "";
        position: absolute;
        top: -14px;
        left: 0;
        right: 0;
        height: 14px;
    }

    #services-dropdown.open {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }

    #services-chevron.open {
        transform: rotate(180deg);
    }
</style>

<script>
    /* ── Scroll shrink ─────────────────────────────────────────────────────── */
    const header = document.getElementById("main-header");
    const inner  = document.getElementById("header-inner");
    const logo   = document.getElementById("header-logo");
    const cta    = document.getElementById("cta-btn");

    function onScroll() {
        const scrolled = window.scrollY > 20;
        header?.classList.toggle("bg-white/85", !scrolled);
        header?.classList.toggle("bg-white/96", scrolled);
        header?.classList.toggle("shadow-[0_4px_24px_rgba(0,0,0,0.08)]", scrolled);
        inner?.classList.toggle("h-20", !scrolled);
        inner?.classList.toggle("h-14", scrolled);
        logo?.classList.toggle("h-16", !scrolled);
        logo?.classList.toggle("h-10", scrolled);
        cta?.classList.toggle("px-6", !scrolled);
        cta?.classList.toggle("py-2.5", !scrolled);
        cta?.classList.toggle("px-4", scrolled);
        cta?.classList.toggle("py-1.5", scrolled);
        cta?.classList.toggle("text-sm", !scrolled);
        cta?.classList.toggle("text-xs", scrolled);
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    /* ── Services dropdown ─────────────────────────────────────────────────── */
    const menu     = document.getElementById("services-menu");
    const trigger  = document.getElementById("services-trigger");
    const dropdown = document.getElementById("services-dropdown");
    const chevron  = document.getElementById("services-chevron");

    function openDropdown() {
        dropdown?.classList.add("open");
        chevron?.classList.add("open");
        trigger?.setAttribute("aria-expanded", "true");
    }

    function closeDropdown() {
        dropdown?.classList.remove("open");
        chevron?.classList.remove("open");
        trigger?.setAttribute("aria-expanded", "false");
    }

    function isOpen() {
        return dropdown?.classList.contains("open");
    }

    /* Desktop: hover */
    const isTouch = () => window.matchMedia("(hover: none)").matches;

    menu?.addEventListener("mouseenter", () => {
        if (!isTouch()) openDropdown();
    });
    menu?.addEventListener("mouseleave", () => {
        if (!isTouch()) closeDropdown();
    });

    /* Touch / click */
    trigger?.addEventListener("click", (e) => {
        e.stopPropagation();
        isOpen() ? closeDropdown() : openDropdown();
    });

    /* Close on outside click */
    document.addEventListener("click", (e) => {
        if (!menu?.contains(e.target as Node)) closeDropdown();
    });

    /* Close on Escape */
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeDropdown();
    });
</script>
