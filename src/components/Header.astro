<header
    id="main-header"
    class="sticky top-0 z-50 w-full bg-white shadow-sm border-b border-slate-100"
>
    <!-- Main nav -->
    <div
        id="header-inner"
        class="max-w-360 mx-auto px-8 h-24 flex items-center justify-between transition-all duration-300"
    >
        <!-- Logo -->
        <a href="/" class="flex items-start self-start shrink-0 relative z-10">
            <img
                id="header-logo"
                src="/logo.png"
                alt="Sistemas Virtuales"
                class="logo-outline h-32 max-w-80 w-auto object-contain object-left transition-all duration-300"
            />
        </a>

        <!-- Nav -->
        <nav class="hidden lg:flex items-center gap-10">
            <a href="/" class="nav-link">Inicio</a>

            <!-- Servicios dropdown -->
            <div class="relative" id="services-menu">
                <button
                    id="services-trigger"
                    aria-haspopup="true"
                    aria-expanded="false"
                    class="nav-link group flex items-center gap-1 bg-transparent border-0 p-0 cursor-pointer"
                >
                    Servicios
                    <svg id="services-chevron" class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#0059a6] transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                </button>

                <!-- Dropdown panel -->
                <div
                    id="services-dropdown"
                    role="menu"
                    class="absolute left-0 top-[calc(100%+12px)] w-72 bg-white border border-slate-100 rounded-2xl shadow-xl shadow-slate-200/60 py-2 opacity-0 pointer-events-none transition-all duration-150 origin-top"
                >
                    <div class="absolute -top-1.5 left-6 w-3 h-3 bg-white border-l border-t border-slate-100 rotate-45"></div>

                    {[
                        { label: "Vehículos Particulares y Motocicletas", slug: "vehiculos-particulares", icon: "M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" },
                        { label: "Transporte de Pasajeros", slug: "transporte-de-pasajeros", icon: "M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" },
                        { label: "Transporte de Hidrocarburos", slug: "transporte-de-hidrocarburos", icon: "M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925 3.546 5.974 5.974 0 01-2.133-1A3.75 3.75 0 0012 18z" },
                        { label: "Maquinaria Amarilla", slug: "maquinaria-amarilla", icon: "M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z" },
                        { label: "Transporte de Carga", slug: "transporte-de-carga", icon: "M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" },
                    ].map((item) => (
                        <a
                            href={`/servicios/${item.slug}`}
                            role="menuitem"
                            class="flex items-center gap-3 px-4 py-2.5 mx-1 rounded-xl text-sm text-slate-700 hover:bg-blue-50 hover:text-[#0059a6] transition-colors duration-150 group"
                        >
                            <span class="w-7 h-7 rounded-lg bg-slate-100 group-hover:bg-blue-100 flex items-center justify-center shrink-0 transition-colors duration-150">
                                <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-[#0059a6]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                                </svg>
                            </span>
                            {item.label}
                        </a>
                    ))}
                </div>
            </div>

            <a href="/nosotros" class="nav-link">Nosotros</a>
            <a href="/planes" class="nav-link">Rastreo GPS</a>
        </nav>

        <!-- CTA desktop -->
        <a
            href="https://wa.me/573157003022?text=Hola%2C%20me%20gustar%C3%ADa%20recibir%20m%C3%A1s%20informaci%C3%B3n."
            target="_blank"
            rel="noopener"
            id="cta-btn"
            class="hidden md:inline-flex items-center gap-2 px-6 py-2.5 bg-[#ffd400] text-[#003d73] text-sm font-bold rounded-full hover:bg-yellow-300 active:scale-[0.98] transition-all duration-200 whitespace-nowrap shadow-lg"
        >
            <span>Contacto</span>
            <svg class="w-4 h-4 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
            </svg>
        </a>

        <!-- Hamburger button (mobile only) -->
        <button
            id="mobile-menu-btn"
            class="lg:hidden flex flex-col justify-center items-center w-10 h-10 rounded-xl gap-1.5 transition-colors duration-200 bg-slate-50 hover:bg-slate-100"
            aria-label="Abrir menú"
            aria-expanded="false"
        >
            <span class="hamburger-bar block w-5 h-0.5 rounded-full transition-all duration-300" style="background-color: #0059a6;"></span>
            <span class="hamburger-bar block w-5 h-0.5 rounded-full transition-all duration-300" style="background-color: #0059a6;"></span>
            <span class="hamburger-bar block w-5 h-0.5 rounded-full transition-all duration-300" style="background-color: #0059a6;"></span>
        </button>
    </div>

    <!-- Mobile menu panel -->
    <div
        id="mobile-menu"
        class="lg:hidden overflow-hidden transition-all duration-300 max-h-0 opacity-0 bg-white border-t border-slate-100"
        aria-hidden="true"
    >
        <nav class="px-6 pb-6 pt-2 flex flex-col gap-1">

            <a href="/" class="mobile-nav-link">Inicio</a>

            <!-- Servicios accordion -->
            <div>
                <button
                    id="mobile-services-btn"
                    class="mobile-nav-link w-full text-left flex items-center justify-between"
                >
                    Servicios
                    <svg id="mobile-services-chevron" class="w-4 h-4 text-slate-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                </button>
                <div id="mobile-services-sub" class="max-h-0 overflow-hidden transition-all duration-300">
                    <div class="pl-4 pt-1 pb-2 flex flex-col gap-1">
                        {[
                            { label: "Vehículos Particulares y Motocicletas", slug: "vehiculos-particulares" },
                            { label: "Transporte de Pasajeros", slug: "transporte-de-pasajeros" },
                            { label: "Transporte de Hidrocarburos", slug: "transporte-de-hidrocarburos" },
                            { label: "Maquinaria Amarilla", slug: "maquinaria-amarilla" },
                            { label: "Transporte de Carga", slug: "transporte-de-carga" },
                        ].map((item) => (
                            <a
                                href={`/servicios/${item.slug}`}
                                class="text-slate-500 hover:text-[#0059a6] text-sm py-2 px-3 rounded-xl hover:bg-slate-50 transition-colors duration-150"
                            >
                                {item.label}
                            </a>
                        ))}
                    </div>
                </div>
            </div>

            <a href="/nosotros" class="mobile-nav-link">Nosotros</a>
            <a href="/planes" class="mobile-nav-link">Rastreo GPS</a>

            <!-- CTA -->
            <a
                href="https://wa.me/573157003022?text=Hola%2C%20me%20gustar%C3%ADa%20recibir%20m%C3%A1s%20informaci%C3%B3n."
                target="_blank"
                rel="noopener"
                class="mt-3 inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-sm font-bold transition-colors duration-200"
                style="background-color: #ffd400; color: #003d73;"
            >
                Contacto
                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
                </svg>
            </a>
        </nav>
    </div>
</header>

<style>
    .logo-outline {
        filter: drop-shadow(0 0 0.2px #000);
    }

    .nav-link {
        position: relative;
        font-size: 0.95rem;
        font-weight: 500;
        color: #334155;
        text-decoration: none;
        letter-spacing: 0.01em;
        padding-bottom: 4px;
        transition: color 0.2s ease;
    }

    .nav-link::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: 0;
        width: 0;
        height: 2px;
        background: #ffd400;
        border-radius: 9999px;
        transition:
            width 0.28s ease,
            left 0.28s ease;
    }

    .nav-link:hover {
        color: #0059a6;
    }

    .nav-link:hover::after {
        left: 0;
        width: 100%;
    }

    #services-trigger {
        font-family: inherit;
    }

    #services-dropdown {
        transform: translateY(-6px);
        transition: opacity 150ms ease, transform 150ms ease;
    }

    #services-dropdown::before {
        content: "";
        position: absolute;
        top: -14px;
        left: 0;
        right: 0;
        height: 14px;
    }

    #services-dropdown.open {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }

    #services-chevron.open {
        transform: rotate(180deg);
    }

    .mobile-nav-link {
        display: block;
        color: #334155;
        font-size: 1rem;
        font-weight: 500;
        padding: 0.625rem 0.75rem;
        border-radius: 0.75rem;
        text-decoration: none;
        transition: background-color 0.15s ease, color 0.15s ease;
        border-bottom: 2px solid transparent;
    }

    .mobile-nav-link:hover {
        background-color: #f8fafc;
        color: #0059a6;
        border-bottom-color: #ffd400;
    }

    #mobile-menu-btn.open .hamburger-bar:nth-child(1) {
        transform: translateY(8px) rotate(45deg);
    }

    #mobile-menu-btn.open .hamburger-bar:nth-child(2) {
        opacity: 0;
        transform: scaleX(0);
    }

    #mobile-menu-btn.open .hamburger-bar:nth-child(3) {
        transform: translateY(-8px) rotate(-45deg);
    }

    #mobile-services-chevron.open {
        transform: rotate(180deg);
    }
</style>

<script>
    /* ── Scroll shrink ─────────────────────────────────────────────────────── */
    const inner  = document.getElementById("header-inner");
    const logo   = document.getElementById("header-logo");
    const cta    = document.getElementById("cta-btn");

    function onScroll() {
        const scrolled = window.scrollY > 20;
        inner?.classList.toggle("h-24", !scrolled);
        inner?.classList.toggle("h-16", scrolled);
        logo?.classList.toggle("h-32", !scrolled);
        logo?.classList.toggle("h-14", scrolled);
        cta?.classList.toggle("px-6", !scrolled);
        cta?.classList.toggle("py-2.5", !scrolled);
        cta?.classList.toggle("px-4", scrolled);
        cta?.classList.toggle("py-1.5", scrolled);
        cta?.classList.toggle("text-sm", !scrolled);
        cta?.classList.toggle("text-xs", scrolled);
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    /* ── Services dropdown ─────────────────────────────────────────────────── */
    const menu     = document.getElementById("services-menu");
    const trigger  = document.getElementById("services-trigger");
    const dropdown = document.getElementById("services-dropdown");
    const chevron  = document.getElementById("services-chevron");

    function openDropdown() {
        dropdown?.classList.add("open");
        chevron?.classList.add("open");
        trigger?.setAttribute("aria-expanded", "true");
    }

    function closeDropdown() {
        dropdown?.classList.remove("open");
        chevron?.classList.remove("open");
        trigger?.setAttribute("aria-expanded", "false");
    }

    function isOpen() {
        return dropdown?.classList.contains("open");
    }

    const isTouch = () => window.matchMedia("(hover: none)").matches;

    menu?.addEventListener("mouseenter", () => {
        if (!isTouch()) openDropdown();
    });
    menu?.addEventListener("mouseleave", () => {
        if (!isTouch()) closeDropdown();
    });

    trigger?.addEventListener("click", (e) => {
        e.stopPropagation();
        isOpen() ? closeDropdown() : openDropdown();
    });

    document.addEventListener("click", (e) => {
        if (!menu?.contains(e.target as Node)) closeDropdown();
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeDropdown();
    });

    /* ── Mobile menu ───────────────────────────────────────────────────────── */
    const mobileBtn  = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const mobileServiceBtn     = document.getElementById("mobile-services-btn");
    const mobileServicesSub    = document.getElementById("mobile-services-sub");
    const mobileServicesChevron = document.getElementById("mobile-services-chevron");

    let mobileOpen = false;
    let mobileServicesOpen = false;

    function openMobileMenu() {
        mobileOpen = true;
        mobileMenu!.style.maxHeight = mobileMenu!.scrollHeight + "px";
        mobileMenu!.style.opacity = "1";
        mobileMenu!.setAttribute("aria-hidden", "false");
        mobileBtn!.classList.add("open");
        mobileBtn!.setAttribute("aria-expanded", "true");
    }

    function closeMobileMenu() {
        mobileOpen = false;
        mobileMenu!.style.maxHeight = "0";
        mobileMenu!.style.opacity = "0";
        mobileMenu!.setAttribute("aria-hidden", "true");
        mobileBtn!.classList.remove("open");
        mobileBtn!.setAttribute("aria-expanded", "false");
    }

    mobileBtn?.addEventListener("click", () => {
        mobileOpen ? closeMobileMenu() : openMobileMenu();
    });

    mobileServiceBtn?.addEventListener("click", () => {
        mobileServicesOpen = !mobileServicesOpen;
        if (mobileServicesOpen) {
            mobileServicesSub!.style.maxHeight = mobileServicesSub!.scrollHeight + "px";
            mobileServicesChevron!.classList.add("open");
        } else {
            mobileServicesSub!.style.maxHeight = "0";
            mobileServicesChevron!.classList.remove("open");
        }
        // Recalculate menu height after sub-menu opens
        setTimeout(() => {
            if (mobileOpen) {
                mobileMenu!.style.maxHeight = mobileMenu!.scrollHeight + "px";
            }
        }, 10);
    });

    // Close mobile menu on outside click
    document.addEventListener("click", (e) => {
        const header = document.getElementById("main-header");
        if (mobileOpen && !header?.contains(e.target as Node)) {
            closeMobileMenu();
        }
    });
</script>
