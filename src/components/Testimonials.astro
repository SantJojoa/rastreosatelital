---
import { testimonials } from "../data/testimonials";
const [featured, ...rest] = testimonials;
---

<section class="py-24" style="background-color: #f0f5fb;">
    <div class="container-custom">
        <div class="mb-14 reveal">
            <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight">
                Lo que dicen <span style="color: #0059a6;">nuestros clientes</span>
            </h2>
            <p class="text-slate-500 mt-4 max-w-md">Más de 1,720 clientes confían en nuestra tecnología para proteger sus vehículos.</p>
        </div>

        <div class="grid lg:grid-cols-5 gap-6 items-stretch reveal-stagger">

            <!-- Featured testimonial -->
            <article class="lg:col-span-3 rounded-3xl p-10 flex flex-col justify-between gap-8 relative overflow-hidden bg-white border-2" style="border-color: rgba(0,89,166,0.15);">
                <div class="absolute -top-12 -right-12 w-48 h-48 rounded-full" style="background-color: rgba(255,212,0,0.12);"></div>
                <div class="absolute -bottom-8 -left-8 w-32 h-32 rounded-full" style="background-color: rgba(0,89,166,0.05);"></div>

                <div class="relative z-10">
                    <svg class="w-10 h-10 mb-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#0059a6" opacity="0.9">
                        <path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179zm10 0C13.553 16.227 13 15 13 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179z"/>
                    </svg>
                    <p class="text-slate-800 text-xl md:text-2xl font-medium leading-relaxed">
                        "{featured.text}"
                    </p>
                </div>

                <div class="relative z-10 flex items-center gap-4 pt-6 border-t border-slate-100">
                    <div class="w-12 h-12 rounded-full flex items-center justify-center font-bold text-lg shrink-0" style="background-color: #0059a6; color: #ffffff;">
                        {featured.name.charAt(0)}
                    </div>
                    <div>
                        <p class="font-semibold text-slate-900 text-sm">{featured.name}</p>
                        <p class="text-slate-400 text-xs mt-0.5">Cliente verificado</p>
                    </div>
                    <div class="flex gap-1 ml-auto">
                        {[...Array(5)].map(() => (
                            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="#ffd400">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                            </svg>
                        ))}
                    </div>
                </div>
            </article>

            <!-- Secondary testimonials -->
            <div class="lg:col-span-2 flex flex-col gap-6">
                {rest.map((t) => (
                    <article class="bg-white border border-slate-100 rounded-3xl p-8 flex flex-col gap-4 flex-1 hover:shadow-md transition-shadow duration-200">
                        <div class="flex gap-1 mb-1">
                            {[...Array(5)].map(() => (
                                <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="#ffd400">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                </svg>
                            ))}
                        </div>
                        <p class="text-slate-700 leading-relaxed text-sm flex-1">"{t.text}"</p>
                        <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
                            <div class="w-9 h-9 rounded-full flex items-center justify-center text-white font-bold text-sm shrink-0" style="background-color: #0059a6;">
                                {t.name.charAt(0)}
                            </div>
                            <div class="flex-1">
                                <p class="font-semibold text-slate-800 text-sm">{t.name}</p>
                                <p class="text-slate-400 text-xs">Cliente verificado</p>
                            </div>
                        </div>
                    </article>
                ))}
            </div>

        </div>

        <!-- Stats strip -->
        <div class="mt-10 grid grid-cols-3 gap-4 text-center">
            <div class="bg-white rounded-2xl py-6 px-4 border border-slate-100">
                <p class="text-2xl font-extrabold" style="color: #0059a6;">4.9/5</p>
                <p class="text-slate-500 text-xs mt-1">Calificación promedio</p>
            </div>
            <div class="bg-white rounded-2xl py-6 px-4 border border-slate-100">
                <p class="text-2xl font-extrabold" style="color: #0059a6;">1,720+</p>
                <p class="text-slate-500 text-xs mt-1">Clientes activos</p>
            </div>
            <div class="bg-white rounded-2xl py-6 px-4 border border-slate-100">
                <p class="text-2xl font-extrabold" style="color: #0059a6;">15 años</p>
                <p class="text-slate-500 text-xs mt-1">De experiencia</p>
            </div>
        </div>
    </div>
</section>
