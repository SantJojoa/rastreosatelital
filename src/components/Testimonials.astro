---
import { testimonials } from "../data/testimonials";
const [featured, ...rest] = testimonials;
---

<section class="py-24 bg-white">
    <div class="container-custom">

        <div class="grid lg:grid-cols-5 gap-6 items-stretch">

            <!-- Featured testimonial (large) -->
            <article class="lg:col-span-3 bg-slate-900 rounded-3xl p-10 flex flex-col justify-between gap-8">
                <div class="flex flex-col gap-6">
                    <svg class="w-10 h-10 text-blue-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179zm10 0C13.553 16.227 13 15 13 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179z"/>
                    </svg>
                    <p class="text-white text-xl md:text-2xl font-medium leading-relaxed">
                        "{featured.text}"
                    </p>
                </div>

                <div class="flex items-center gap-4 pt-6 border-t border-white/10">
                    <img
                        src={featured.image}
                        alt={featured.name}
                        class="w-12 h-12 rounded-full object-cover"
                        onerror={`this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(featured.name)}&background=1d4ed8&color=fff&size=48'`}
                    />
                    <div>
                        <p class="font-semibold text-white text-sm">{featured.name}</p>
                        <p class="text-slate-400 text-xs mt-0.5">Cliente verificado</p>
                    </div>
                    <div class="flex gap-1 ml-auto">
                        {[...Array(5)].map(() => (
                            <svg class="w-4 h-4 text-amber-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                            </svg>
                        ))}
                    </div>
                </div>
            </article>

            <!-- Secondary testimonials (stacked) -->
            <div class="lg:col-span-2 flex flex-col gap-6">
                {rest.map((t) => (
                    <article class="bg-slate-50 border border-slate-100 rounded-3xl p-8 flex flex-col gap-4 flex-1">
                        <p class="text-slate-700 leading-relaxed text-sm flex-1">"{t.text}"</p>
                        <div class="flex items-center gap-3 pt-4 border-t border-slate-200">
                            <img
                                src={t.image}
                                alt={t.name}
                                class="w-9 h-9 rounded-full object-cover"
                                onerror={`this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(t.name)}&background=dbeafe&color=1d4ed8&size=36'`}
                            />
                            <div class="flex-1">
                                <p class="font-semibold text-slate-800 text-sm">{t.name}</p>
                                <p class="text-slate-400 text-xs">Cliente verificado</p>
                            </div>
                            <div class="flex gap-0.5">
                                {[...Array(5)].map(() => (
                                    <svg class="w-3.5 h-3.5 text-amber-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                    </svg>
                                ))}
                            </div>
                        </div>
                    </article>
                ))}
            </div>

        </div>

        <!-- Section label below -->
        <div class="mt-10 flex items-center gap-4">
            <div class="h-px flex-1 bg-slate-100"></div>
            <p class="text-slate-400 text-sm font-medium">Lo que dicen nuestros clientes</p>
            <div class="h-px flex-1 bg-slate-100"></div>
        </div>

    </div>
</section>
