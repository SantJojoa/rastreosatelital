---
import { testimonials } from "../data/testimonials";
---

<section class="py-24 bg-slate-50">
    <div class="container-custom">
        <!-- Header -->
        <div class="text-center mb-16">
            <span class="inline-block px-4 py-1.5 rounded-full bg-blue-50 text-blue-600 text-sm font-semibold tracking-wide mb-4">
                Testimonios
            </span>
            <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight">
                Impacto <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500">Real</span>
            </h2>
            <p class="text-slate-500 mt-4 max-w-xl mx-auto">Lo que dicen nuestros clientes sobre su experiencia con la plataforma.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
            {testimonials.map((t, i) => (
                <article class="group relative bg-white rounded-3xl p-8 border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col gap-6">
                    <!-- Quote icon -->
                    <svg class="w-8 h-8 text-blue-200 group-hover:text-blue-300 transition-colors duration-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179zm10 0C13.553 16.227 13 15 13 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179z"/>
                    </svg>

                    <p class="text-slate-600 leading-relaxed flex-1">"{t.text}"</p>

                    <!-- Stars -->
                    <div class="flex gap-1">
                        {[...Array(5)].map(() => (
                            <svg class="w-4 h-4 text-amber-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                            </svg>
                        ))}
                    </div>

                    <!-- Author -->
                    <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
                        <img
                            src={t.image}
                            alt={t.name}
                            class="w-11 h-11 rounded-full object-cover ring-2 ring-blue-100"
                            onerror="this.src='https://ui-avatars.com/api/?name=' + encodeURIComponent(this.alt) + '&background=dbeafe&color=1d4ed8&size=44'"
                        />
                        <div>
                            <p class="font-semibold text-slate-800 text-sm">{t.name}</p>
                            <p class="text-slate-400 text-xs">Cliente verificado</p>
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>
