---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MainLayout from "../layouts/MainLayout.astro";
import Plans from "../components/Plans.astro";
import { PLANS } from "../data/services";
---

<MainLayout>
    <slot name="head" slot="head">
        <title>Planes de Rastreo Satelital | Sistemas Virtuales</title>
        <meta name="description" content="Conoce los planes de rastreo satelital de Sistemas Virtuales: Básico, Administrativo y Extra. Todos con instalación profesional y soporte 24/7." />
    </slot>

    <Header />

    <main>
        <!-- Hero -->
        <section class="bg-[#0059a6] pt-32 pb-20 md:pt-40 md:pb-28 relative overflow-hidden">
            <div class="absolute inset-0 dot-grid-light opacity-20 pointer-events-none"></div>
            <div class="absolute top-1/2 right-0 w-[500px] h-[500px] bg-white/5 rounded-full blur-3xl -translate-y-1/2 pointer-events-none"></div>

            <div class="container-custom relative z-10 text-center">
                <div class="inline-flex items-center gap-2 mb-6 px-4 py-2 rounded-full bg-white/15 border border-white/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#ffd400]"></span>
                    <span class="text-white/90 text-sm font-medium">Precios según tamaño de flota</span>
                </div>
                <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight mb-5" style="text-wrap: balance;">
                    Planes de Rastreo Satelital
                </h1>
                <p class="text-blue-100 text-lg md:text-xl max-w-2xl mx-auto leading-relaxed">
                    Instalación profesional, soporte técnico 24/7 y tecnología de punta. Elige el plan que se adapta a tu operación.
                </p>
            </div>
        </section>

        <!-- Plans section (reuse component but inline so plans are at top) -->
        <section class="py-20 md:py-28 bg-[#f0f5fb]">
            <div class="container-custom">
                <div class="grid md:grid-cols-3 gap-5 items-start max-w-5xl mx-auto reveal-stagger">
                    {PLANS.map((plan) => (
                        <article class={`relative flex flex-col gap-5 rounded-3xl p-8 border-2 transition-all duration-200 ${
                            plan.highlighted
                                ? "bg-[#0059a6] border-[#0059a6] shadow-xl shadow-[#0059a6]/20 md:-mt-4 md:mb-4"
                                : "bg-white border-slate-200 hover:border-[#0059a6]/40 hover:shadow-lg"
                        }`}>
                            {plan.highlighted && (
                                <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 bg-[#ffd400] text-[#003d73] text-xs font-bold rounded-full uppercase tracking-wide whitespace-nowrap shadow">
                                    ★ Recomendado
                                </span>
                            )}

                            <div>
                                <h3 class={`text-xl font-extrabold tracking-tight ${plan.highlighted ? "text-white" : "text-slate-900"}`}>
                                    {plan.name}
                                </h3>
                                <p class={`text-sm mt-1.5 leading-relaxed ${plan.highlighted ? "text-blue-200" : "text-slate-500"}`}>
                                    {plan.description}
                                </p>
                            </div>

                            <div class={`h-px ${plan.highlighted ? "bg-white/20" : "bg-slate-100"}`}></div>

                            <ul class="flex flex-col gap-2.5 flex-1">
                                {plan.features.map((feature) => (
                                    <li class={`flex items-start gap-2.5 text-sm ${plan.highlighted ? "text-blue-100" : "text-slate-600"}`}>
                                        <svg class={`w-4 h-4 shrink-0 mt-0.5 ${plan.highlighted ? "text-[#ffd400]" : "text-[#0059a6]"}`} fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                        </svg>
                                        {feature}
                                    </li>
                                ))}
                            </ul>

                            <a
                                href="https://wa.me/573157003022"
                                target="_blank"
                                rel="noopener"
                                class={`mt-2 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full text-sm font-bold transition-all duration-150 ${
                                    plan.highlighted
                                        ? "bg-[#ffd400] text-[#003d73] hover:bg-yellow-300"
                                        : "bg-[#0059a6] text-white hover:bg-[#004a8c]"
                                }`}
                            >
                                Consultar precio
                                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
                                </svg>
                            </a>
                        </article>
                    ))}
                </div>

                <p class="text-center text-slate-400 text-sm mt-8">
                    ¿Tienes una flota grande? <a href="https://wa.me/573157003022" target="_blank" rel="noopener" class="text-[#0059a6] font-semibold hover:underline">Solicita una cotización personalizada →</a>
                </p>
            </div>
        </section>

        <!-- What's included -->
        <section class="py-20 bg-white">
            <div class="container-custom">
                <div class="max-w-xl mb-12 reveal">
                    <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-3">Todos los planes incluyen</h2>
                    <p class="text-slate-500">Sin importar el plan que elijas, estos beneficios siempre están incluidos.</p>
                </div>

                <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 reveal-stagger">
                    {[
                        { title: "Instalación profesional", desc: "Técnicos certificados realizan la instalación en tu vehículo.", icon: "M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z" },
                        { title: "Soporte 24/7", desc: "Línea de atención para emergencias disponible todos los días.", icon: "M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" },
                        { title: "App móvil gratis", desc: "Disponible para Android e iOS. Sin costo adicional.", icon: "M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 8.25h3" },
                        { title: "Cobertura internacional", desc: "Tu flota monitoreada sin importar en qué país esté.", icon: "M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" },
                        { title: "Multiusuarios", desc: "Varios operadores pueden ingresar a la plataforma simultáneamente.", icon: "M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" },
                        { title: "Histórico de viajes", desc: "Consulta rutas pasadas, tiempos y velocidades desde APP o PC.", icon: "M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z" },
                    ].map((item) => (
                        <div class="flex gap-4 p-6 bg-slate-50 rounded-2xl">
                            <div class="w-10 h-10 rounded-xl bg-[#0059a6] flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                                </svg>
                            </div>
                            <div>
                                <h3 class="font-bold text-slate-900 text-base">{item.title}</h3>
                                <p class="text-slate-500 text-sm mt-1 leading-relaxed">{item.desc}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="py-16 bg-[#0059a6]">
            <div class="container-custom text-center reveal">
                <h2 class="text-2xl md:text-3xl font-extrabold text-white mb-3">¿Tienes dudas sobre qué plan elegir?</h2>
                <p class="text-blue-100 mb-7 max-w-md mx-auto">Nuestro equipo te asesora sin costo y te recomienda el plan ideal para tu flota.</p>
                <a
                    href="https://wa.me/573157003022"
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-2 px-8 py-4 bg-[#ffd400] text-[#003d73] font-bold rounded-full hover:bg-yellow-300 transition-colors duration-200"
                >
                    Asesoría gratuita por WhatsApp
                    <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
                    </svg>
                </a>
            </div>
        </section>
    </main>

    <Footer />
</MainLayout>
