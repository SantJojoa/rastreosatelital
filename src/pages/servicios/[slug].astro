---
import { SERVICES, PLANS } from "../../data/services";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import MainLayout from "../../layouts/MainLayout.astro";

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const { title, subtitle, description, sections, subServices, image, accent } = service;

// Stats dinámicos calculados del contenido real del servicio
const totalFeatures =
  sections.reduce((acc, s) => acc + s.items.length, 0) +
  (subServices?.reduce((acc, s) => acc + s.items.length, 0) ?? 0);
const totalSections = sections.length + (subServices?.length ?? 0);



// Paths de iconos para cada modalidad (moto/vehículo, transporte, bicicleta)
const modalidadIconPaths = [
  ["M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"],
  ["M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12", "M12 6.75l2.25 4.5H9.75L12 6.75z"],
  ["M15 10.5a3 3 0 11-6 0 3 3 0 016 0z", "M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"],
];
---

<MainLayout
  title={`${title} ${subtitle} | Sistemas Virtuales`}
  description={description}
  image={image}
>
  <Header />

  <main>
    <!-- ── Hero ──────────────────────────────────────────────────────────────── -->
    <section class="relative bg-white overflow-hidden pt-12 pb-16 md:pb-20">
      <div class="absolute inset-0 dot-grid opacity-60 pointer-events-none"></div>
      <div
        class="absolute -top-32 -right-32 w-[520px] h-[520px] rounded-full blur-3xl pointer-events-none"
        style={`background-color: ${accent}12;`}
      ></div>

      <div class="container-custom relative z-10">
        <nav class="flex items-center gap-2 text-slate-400 text-sm mb-10" aria-label="Breadcrumb">
          <a href="/" class="hover:text-[#0059a6] transition-colors duration-150">Inicio</a>
          <span aria-hidden="true">/</span>
          <a href="/planes#servicios" class="hover:text-[#0059a6] transition-colors duration-150">Servicios</a>
          <span aria-hidden="true">/</span>
          <span class="text-slate-700">{title}</span>
        </nav>

        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="reveal is-visible" style="transition-delay:150ms">
            <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-[1.08] mb-5" style="text-wrap: balance;">
              {title}
              <span class="block" style={`color: ${accent};`}>{subtitle}</span>
            </h1>
            <p class="text-base text-slate-600 leading-relaxed max-w-lg mb-8">
              {description}
            </p>
            <div class="flex flex-wrap gap-3">
            </div>
          </div>

          <!-- Right: foto real del servicio -->
          <div class="relative reveal is-visible" style="transition-delay:250ms">
            <div class="relative rounded-3xl overflow-hidden aspect-[4/3] shadow-xl">
              <img
                src={image}
                alt={`${title} ${subtitle}`}
                class="absolute inset-0 w-full h-full object-cover"
              />
              <div
                class="absolute inset-0"
                style="background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.05) 45%, rgba(0,0,0,0.15) 100%);"
              ></div>
              <div
                class="absolute top-5 right-5 w-12 h-12 rounded-2xl flex items-center justify-center text-white shadow-lg ring-2 ring-white/30"
                style={`background-color: ${accent};`}
              >
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Stats dinámicos del servicio -->

      </div>
    </section>

    <!-- ── Planes ─────────────────────────────────────────────────────────── -->
    <section class="py-16" style="background-color: var(--surface-tint);">
      <div class="container-custom">
        <div class="mb-8 text-center">
          <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">
            Planes disponibles
          </h2>
          <p class="text-slate-500 mt-2 text-sm mx-auto max-w-md">
            Todos incluyen instalación profesional y soporte técnico. Precio según el tamaño de tu flota.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-4 items-start max-w-5xl mx-auto reveal-stagger">
          {PLANS.map((plan) => (
            <article class={`relative flex flex-col gap-5 rounded-2xl p-7 border-2 transition-all duration-200 bg-white ${
              plan.highlighted
                ? "shadow-xl md:-mt-4 md:mb-4"
                : "border-slate-200 hover:border-[#0059a6]/40"
            }`} style={plan.highlighted ? "border-color: #0059a6; box-shadow: 0 20px 40px -12px rgba(0,89,166,0.25);" : ""}>
              {plan.highlighted && (
                <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 bg-[#ffd400] text-[#003d73] text-xs font-bold rounded-full uppercase tracking-wide whitespace-nowrap shadow">
                  ★ Recomendado
                </span>
              )}

              <div>
                <h3 class="text-base font-bold text-slate-900">
                  {plan.name}
                </h3>
                <p class="text-xs mt-1 leading-relaxed text-slate-500">
                  {plan.description}
                </p>
              </div>

              <div class="h-px bg-slate-100"></div>

              <ul class="flex flex-col gap-2.5 flex-1">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-2 text-sm text-slate-600">
                    <svg class="w-3.5 h-3.5 shrink-0 mt-0.5 text-[#0059a6]" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>

              <a
                href="https://wa.me/573157003022"
                target="_blank"
                rel="noopener"
                class={`mt-2 inline-flex items-center justify-center px-4 py-2.5 rounded-full text-sm font-bold transition-all duration-150 ${
                  plan.highlighted
                    ? "bg-[#ffd400] text-[#003d73] hover:bg-yellow-300"
                    : "bg-[#0059a6] text-white hover:bg-[#004a8c]"
                }`}
              >
                Consultar precio
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Modalidades (layout divide-y: icono + título / features) ────────── -->
    {subServices && subServices.length > 0 && (
      <section class="py-20 bg-white">
        <div class="container-custom">
          <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight mb-10">
            Modalidades de rastreo
          </h2>

          <div class="divide-y divide-slate-100 reveal-stagger">
            {subServices.map((sub, i) => (
              <div class="py-8 grid md:grid-cols-[1fr_2fr] gap-6 md:gap-12 items-start">
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background-color: rgba(0,89,166,0.08); color: #0059a6;">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                      {(modalidadIconPaths[i] ?? modalidadIconPaths[0]).map((d) => (
                        <path stroke-linecap="round" stroke-linejoin="round" d={d} />
                      ))}
                    </svg>
                  </div>
                  <h3 class="text-lg font-bold text-slate-900 leading-snug pt-1.5">{sub.title}</h3>
                </div>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  {sub.items.map((item) => (
                    <li class="flex items-center gap-2.5 text-sm text-slate-600">
                      <svg class="w-4 h-4 shrink-0 text-[#0059a6]" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ── Secciones "Lo que incluye" ────────────────────────────────────── -->
    {sections.length > 0 && (
      <section class="py-20" style="background-color: var(--surface-tint);">
        <div class="container-custom">
          <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight mb-10">
            Lo que incluye {subtitle}
          </h2>

          <div class="flex flex-col gap-4 reveal-stagger">
            {sections.map((section) => (
              <div class="bg-white border border-slate-100 rounded-3xl overflow-hidden">
                <div class="grid md:grid-cols-[260px_1fr]">
                  <!-- Left: título con icono -->
                  <div class="border-b md:border-b-0 md:border-r border-slate-100 p-6 flex flex-col justify-between gap-4">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style="background-color: rgba(0,89,166,0.08); color: #0059a6;">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
                        </svg>
                      </div>
                      <h3 class="text-base font-bold text-slate-900 leading-snug">{section.title}</h3>
                    </div>
                    <span class="text-xs font-mono text-slate-400 pl-1">
                      {section.items.length} funciones
                    </span>
                  </div>

                  <!-- Right: features -->
                  <div class="p-6">
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-2.5">
                      {section.items.map((item) => (
                        <li class="flex items-start gap-2.5 text-sm text-slate-600 leading-relaxed">
                          <svg class="w-4 h-4 shrink-0 mt-0.5 text-[#0059a6]" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                          </svg>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ── Franja de contacto ─────────────────────────────────────────────── -->
    <div class="border-t border-slate-100 bg-white">
      <div class="container-custom py-10 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <p class="font-semibold text-slate-900">¿Necesitas orientación antes de decidir?</p>
          <p class="text-slate-500 text-sm mt-0.5">Te asesoramos sin costo y resolvemos todas tus dudas.</p>
        </div>
        <div class="flex flex-wrap gap-3 shrink-0">
          <a
            href="https://wa.me/573157003022"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#0059a6] hover:bg-[#004a8c] text-white text-sm font-semibold rounded-full active:scale-[0.98] transition-all duration-150"
          >
            Escribir por WhatsApp
          </a>
          <a
            href="/planes#servicios"
            class="inline-flex items-center gap-2 px-5 py-2.5 border border-slate-200 hover:border-[#0059a6]/40 text-slate-700 text-sm font-semibold rounded-full active:scale-[0.98] transition-all duration-150"
          >
            Ver todos los servicios
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</MainLayout>
