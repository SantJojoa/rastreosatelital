---
import { SERVICES, PLANS } from "../../data/services";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const { title, subtitle, description, sections, subServices } = service;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} {subtitle} | Sistemas Virtuales</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/logo.png" type="image/png" />
  </head>
  <body class="bg-white">
    <Header />

    <!-- ── Hero ──────────────────────────────────────────────────────────────
         Layout: left-aligned, dark, max pt-24, 4 elements max (breadcrumb,
         h1, description, 2 CTAs). Single eyebrow (the only one on this page).
    ──────────────────────────────────────────────────────────────────────── -->
    <section class="bg-slate-950 pt-24 pb-20 relative overflow-hidden">
      <div
        class="absolute inset-0 pointer-events-none"
        style="background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 72px 72px;"
        aria-hidden="true"
      ></div>
      <div
        class="absolute top-0 right-0 w-[500px] h-[500px] rounded-full pointer-events-none"
        style="background: radial-gradient(circle, rgba(37,99,235,0.18) 0%, transparent 65%); filter: blur(60px);"
        aria-hidden="true"
      ></div>

      <div class="container-custom relative z-10">
        <nav class="flex items-center gap-2 text-slate-500 text-sm mb-10" aria-label="Breadcrumb">
          <a href="/" class="hover:text-slate-300 transition-colors duration-150">Inicio</a>
          <span aria-hidden="true">/</span>
          <span class="text-white">{subtitle}</span>
        </nav>

        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <p class="font-mono text-xs font-medium text-blue-400 tracking-[0.18em] uppercase mb-5">
              Sistemas Virtuales
            </p>
            <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-[1.08] mb-5">
              {title}
              <span class="block text-blue-400">{subtitle}</span>
            </h1>
            <p class="text-base text-slate-400 leading-relaxed max-w-lg mb-8">
              {description}
            </p>
            <div class="flex flex-wrap gap-3">
              <a
                href="https://wa.me/573157003022"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold rounded-lg active:scale-[0.98] transition-all duration-150"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                Solicitar por WhatsApp
              </a>
              <a
                href="tel:3157003022"
                class="inline-flex items-center gap-2 px-5 py-2.5 border border-slate-700 hover:border-slate-500 text-slate-300 hover:text-white text-sm font-semibold rounded-lg active:scale-[0.98] transition-all duration-150"
              >
                315 700 3022
              </a>
            </div>
          </div>

          <!-- Right: stat pills -->
          <div class="hidden lg:grid grid-cols-2 gap-3">
            {[
              { label: "Cobertura internacional", value: "Siempre conectados" },
              { label: "Soporte técnico", value: "24/7" },
              { label: "Instalación", value: "Profesional" },
              { label: "Plataforma web", value: "+ APP móvil" },
            ].map((stat) => (
              <div class="bg-white/5 border border-white/8 rounded-xl p-5">
                <p class="text-slate-400 text-xs font-medium mb-1">{stat.label}</p>
                <p class="text-white font-bold text-lg">{stat.value}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── Sub-servicios (layout: lista con divisores, NO cards en grid) ────
         Aplica solo cuando el servicio agrupa varias modalidades.
         Usa divide-y en lugar de 3 cards iguales para romper el patrón.
    ──────────────────────────────────────────────────────────────────────── -->
    {subServices && subServices.length > 0 && (
      <section class="py-20 bg-white">
        <div class="container-custom">
          <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight mb-10">
            Modalidades de rastreo
          </h2>

          <div class="divide-y divide-slate-100">
            {subServices.map((sub, i) => {
              const icons = [
                /* Vehículo / carro */
                <svg class="w-5 h-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>,
                /* Motocicleta */
                <svg class="w-5 h-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /><circle cx="18" cy="18.75" r="0" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75l2.25 4.5H9.75L12 6.75z" /></svg>,
                /* Bicicleta / GPS */
                <svg class="w-5 h-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>,
              ];
              return (
                <div class="py-8 grid md:grid-cols-[1fr_2fr] gap-6 md:gap-12 items-start">
                  <!-- Left: icono + title -->
                  <div class="flex items-start gap-4">
                    <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center shrink-0">
                      {icons[i] ?? icons[0]}
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 leading-snug pt-1.5">{sub.title}</h3>
                  </div>
                  <!-- Right: features in 2-col pill grid -->
                  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    {sub.items.map((item) => (
                      <li class="flex items-center gap-2.5 text-sm text-slate-600">
                        <svg class="w-4 h-4 shrink-0 text-blue-500" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- ── Secciones específicas (layout: split 2-col izq=titulo / der=lista)
         Diferente familia de layout que sub-servicios y planes.
    ──────────────────────────────────────────────────────────────────────── -->
    {sections.length > 0 && (
      <section class="py-20 bg-slate-50">
        <div class="container-custom">
          <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight mb-10">
            Lo que incluye {subtitle}
          </h2>

          <div class="flex flex-col gap-5">
            {sections.map((section, i) => (
              <div class={`rounded-2xl overflow-hidden border ${i % 2 === 0 ? "bg-slate-900 border-slate-800" : "bg-white border-slate-200"}`}>
                <div class="grid md:grid-cols-[280px_1fr]">
                  <!-- Left: título de la sección -->
                  <div class={`p-8 flex flex-col justify-between border-b md:border-b-0 md:border-r ${i % 2 === 0 ? "border-slate-800" : "border-slate-100"}`}>
                    <div>
                      <div class={`w-9 h-9 rounded-lg flex items-center justify-center mb-5 ${i % 2 === 0 ? "bg-blue-600" : "bg-slate-100"}`}>
                        <svg class={`w-4 h-4 ${i % 2 === 0 ? "text-white" : "text-blue-600"}`} fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                        </svg>
                      </div>
                      <h3 class={`text-lg font-bold leading-snug ${i % 2 === 0 ? "text-white" : "text-slate-900"}`}>
                        {section.title}
                      </h3>
                    </div>
                    <span class={`text-xs font-mono mt-6 ${i % 2 === 0 ? "text-slate-600" : "text-slate-400"}`}>
                      {section.items.length} funciones
                    </span>
                  </div>

                  <!-- Right: lista de features en 2 columnas -->
                  <div class="p-8">
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3">
                      {section.items.map((item) => (
                        <li class={`flex items-start gap-2.5 text-sm leading-relaxed ${i % 2 === 0 ? "text-slate-300" : "text-slate-600"}`}>
                          <svg class={`w-4 h-4 shrink-0 mt-0.5 ${i % 2 === 0 ? "text-blue-400" : "text-blue-500"}`} fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                          </svg>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ── Planes (layout asimétrico: card grande centro + dos flancos) ─────
         Familia diferente al resto: card central destacado con escala visual.
    ──────────────────────────────────────────────────────────────────────── -->
    <section class="py-20 bg-white">
      <div class="container-custom">
        <div class="mb-10 text-center">
          <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">
            Planes disponibles
          </h2>
          <p class="text-slate-500 mt-2 text-sm mx-auto max-w-md">
            Todos incluyen instalacion profesional y soporte tecnico. Precio segun el tamano de tu flota.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-4 items-start max-w-5xl mx-auto">
          {PLANS.map((plan) => (
            <article class={`relative flex flex-col gap-5 rounded-2xl p-7 border transition-all duration-200 ${
              plan.highlighted
                ? "bg-slate-900 border-blue-600/50 shadow-lg shadow-blue-600/10 md:-mt-4 md:mb-4"
                : "bg-slate-50 border-slate-200 hover:border-slate-300"
            }`}>
              {plan.highlighted && (
                <span class="absolute -top-3 left-6 px-2.5 py-0.5 bg-blue-600 text-white text-xs font-bold rounded-full uppercase tracking-wide">
                  Recomendado
                </span>
              )}

              <div>
                <h3 class={`text-base font-bold ${plan.highlighted ? "text-white" : "text-slate-900"}`}>
                  {plan.name}
                </h3>
                <p class={`text-xs mt-1 leading-relaxed ${plan.highlighted ? "text-slate-400" : "text-slate-500"}`}>
                  {plan.description}
                </p>
              </div>

              <div class={`h-px ${plan.highlighted ? "bg-slate-700" : "bg-slate-200"}`}></div>

              <ul class="flex flex-col gap-2.5 flex-1">
                {plan.features.map((feature) => (
                  <li class={`flex items-start gap-2 text-sm ${plan.highlighted ? "text-slate-300" : "text-slate-600"}`}>
                    <svg class={`w-3.5 h-3.5 shrink-0 mt-0.5 ${plan.highlighted ? "text-blue-400" : "text-blue-500"}`} fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>

              <a
                href="https://wa.me/573157003022"
                target="_blank"
                rel="noopener"
                class={`mt-2 inline-flex items-center justify-center px-4 py-2.5 rounded-lg text-sm font-semibold transition-all duration-150 active:scale-[0.98] ${
                  plan.highlighted
                    ? "bg-blue-600 hover:bg-blue-500 text-white"
                    : "bg-white hover:bg-slate-100 text-slate-900 border border-slate-200"
                }`}
              >
                Consultar precio
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Franja de contacto (reemplaza CTA final redundante) ──────────────
         Layout horizontal, no duplica el intent del hero.
         No es otra sección oscura completa, es una franja compacta.
    ──────────────────────────────────────────────────────────────────────── -->
    <div class="border-t border-slate-100 bg-slate-50">
      <div class="container-custom py-10 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <p class="font-semibold text-slate-900">¿Necesitas orientacion antes de decidir?</p>
          <p class="text-slate-500 text-sm mt-0.5">Te asesoramos sin costo y resolvemos todas tus dudas.</p>
        </div>
        <div class="flex flex-wrap gap-3 shrink-0">
          <a
            href="https://wa.me/573157003022"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold rounded-lg active:scale-[0.98] transition-all duration-150"
          >
            Escribir por WhatsApp
          </a>
          <a
            href="/"
            class="inline-flex items-center gap-2 px-5 py-2.5 border border-slate-200 hover:border-slate-300 text-slate-700 text-sm font-semibold rounded-lg active:scale-[0.98] transition-all duration-150"
          >
            Ver todos los servicios
          </a>
        </div>
      </div>
    </div>

    <Footer />
  </body>
</html>
