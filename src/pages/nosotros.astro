---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
    title="Nosotros | Sistemas Virtuales Zona Andina"
    description="Conozca quiénes somos: 15 años de experiencia en rastreo satelital, administración remota de móviles y cámaras IP en Colombia."
>
    <Header />

    <main>
        <!-- ══════════════════════════════════════
             HERO
        ══════════════════════════════════════ -->
        <section class="relative bg-white overflow-hidden pt-32 pb-24 md:pt-40 md:pb-32">
            <!-- Dot texture -->
            <div class="absolute inset-0 dot-grid opacity-60 pointer-events-none"></div>

            <!-- Glow -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full blur-3xl pointer-events-none" style="background-color: rgba(0,89,166,0.08);"></div>

            <div class="container-custom relative z-10">
                <div class="max-w-3xl reveal is-visible">
                    <!-- Year badge -->
                    <div class="inline-flex items-center gap-2.5 mb-8 px-4 py-2 rounded-full" style="border: 1px solid rgba(0,89,166,0.2); background-color: rgba(0,89,166,0.08);">
                        <span class="w-1.5 h-1.5 rounded-full" style="background-color: #0059a6;"></span>
                        <span class="text-sm font-medium" style="color: #0059a6;">Desde 2009 · 15 años de experiencia</span>
                    </div>

                    <h1 class="text-4xl md:text-6xl xl:text-7xl font-extrabold text-slate-900 leading-[1.08] tracking-tight mb-6" style="text-wrap: balance;">
                        Seguridad y tranquilidad,<br />
                        <span style="color: #0059a6;">respaldadas por experiencia</span>
                    </h1>

                    <p class="text-slate-600 text-lg md:text-xl leading-relaxed max-w-2xl" style="text-wrap: pretty;">
                        Somos <strong class="text-slate-900 font-semibold">SISTEMAS VIRTUALES ZONA ANDINA S.A.S.</strong>, una empresa privada, legalmente constituida, que brinda seguridad y tranquilidad a sus usuarios contando con las mejores herramientas tecnológicas para la administración remota. Un equipo humano, profesional y de alto nivel ético, dispuesto a servir.
                    </p>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════
             HISTORIA / EXPERIENCIA
        ══════════════════════════════════════ -->
        <section class="py-20 md:py-28" style="background-color: var(--surface-tint);">
            <div class="container-custom">
                <div class="grid lg:grid-cols-2 gap-16 items-center reveal">
                    <!-- Text -->
                    <div class="flex flex-col gap-6">
                        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight" style="text-wrap: balance;">
                            15 años cuidando lo que más importa
                        </h2>
                        <p class="text-slate-600 text-base md:text-lg leading-relaxed" style="text-wrap: pretty;">
                            Contamos con 15 años de experiencia dedicados al servicio de Rastreo Satelital, Administración Remota de Móviles y cámaras IP —vehiculares y residenciales—. Todo bajo Tecnología de Punta y software de avanzada.
                        </p>
                        <p class="text-slate-600 text-base md:text-lg leading-relaxed" style="text-wrap: pretty;">
                            Cada cliente que confía en nosotros recibe soluciones personalizadas. No vendemos paquetes genéricos: conocemos su flota, su operación y sus necesidades.
                        </p>
                        <a
                            href="https://wa.me/573157003022"
                            target="_blank"
                            rel="noopener"
                            class="self-start inline-flex items-center gap-2 px-7 py-3.5 bg-[#0059a6] hover:bg-[#004a8c] text-white font-semibold rounded-full transition-colors duration-200 mt-2"
                        >
                            Hablar con nosotros
                            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
                            </svg>
                        </a>
                    </div>

                    <!-- Visual: timeline-style milestones -->
                    <div class="flex flex-col gap-0 reveal-stagger">
                        <div class="milestone-item flex items-start gap-5 pb-8">
                            <div class="flex flex-col items-center shrink-0">
                                <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-sm shrink-0" style="background-color: #0059a6;">09</div>
                                <div class="w-px flex-1 mt-2 min-h-[40px]" style="background-color: rgba(0,89,166,0.15);"></div>
                            </div>
                            <div class="pt-1.5">
                                <p class="font-bold text-slate-900 text-base">Fundación</p>
                                <p class="text-slate-500 text-sm leading-relaxed mt-1">Iniciamos operaciones con los primeros equipos de rastreo GPS para flotas vehiculares.</p>
                            </div>
                        </div>

                        <div class="milestone-item flex items-start gap-5 pb-8">
                            <div class="flex flex-col items-center shrink-0">
                                <div class="w-10 h-10 rounded-full border-2 flex items-center justify-center font-bold text-sm shrink-0" style="background-color: rgba(0,89,166,0.15); border-color: #0059a6; color: #0059a6;">15</div>
                                <div class="w-px flex-1 mt-2 min-h-[40px]" style="background-color: rgba(0,89,166,0.15);"></div>
                            </div>
                            <div class="pt-1.5">
                                <p class="font-bold text-slate-900 text-base">Expansión de servicios</p>
                                <p class="text-slate-500 text-sm leading-relaxed mt-1">Incorporamos cámaras vehiculares IP, administración remota de móviles y soluciones para maquinaria amarilla.</p>
                            </div>
                        </div>

                        <div class="milestone-item flex items-start gap-5">
                            <div class="flex flex-col items-center shrink-0">
                                <div class="w-10 h-10 rounded-full bg-[#003d73] flex items-center justify-center text-white font-bold text-sm shrink-0">Hoy</div>
                            </div>
                            <div class="pt-1.5">
                                <p class="font-bold text-slate-900 text-base">Más de 1,720 clientes activos</p>
                                <p class="text-slate-500 text-sm leading-relaxed mt-1">Seguimos creciendo con tecnología de punta y el mismo compromiso humano del primer día.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════
             STATS
        ══════════════════════════════════════ -->
        <section class="relative py-16 overflow-hidden" style="background: linear-gradient(120deg, var(--secondary) 0%, var(--secondary-container) 100%);">
            <div class="absolute inset-0 dot-grid-light opacity-70 pointer-events-none"></div>
            <div class="container-custom relative z-10">
                <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-white/15 reveal-stagger">
                    <div class="flex flex-col items-center justify-center px-8 py-10 text-center">
                        <p
                            class="text-5xl md:text-6xl font-extrabold text-white tracking-tight stat-number leading-none"
                            data-target="1720"
                            data-prefix=""
                            data-suffix="+&nbsp;clientes"
                            data-raw="1,720+ clientes"
                        >
                            1,720+ clientes
                        </p>
                        <p class="text-blue-100/80 text-sm font-medium mt-3">activos actualmente</p>
                    </div>

                    <div class="flex flex-col items-center justify-center px-8 py-10 text-center">
                        <p
                            class="text-5xl md:text-6xl font-extrabold text-white tracking-tight stat-number leading-none"
                            data-target="4130"
                            data-prefix=""
                            data-suffix="+&nbsp;vehículos"
                            data-raw="4,130+ vehículos"
                        >
                            4,130+ vehículos
                        </p>
                        <p class="text-blue-100/80 text-sm font-medium mt-3">monitoreados con GPS</p>
                    </div>

                    <div class="flex flex-col items-center justify-center px-8 py-10 text-center">
                        <p
                            class="text-5xl md:text-6xl font-extrabold text-white tracking-tight stat-number leading-none"
                            data-target="15"
                            data-prefix=""
                            data-suffix="+&nbsp;años"
                            data-raw="15+ años"
                        >
                            15+ años
                        </p>
                        <p class="text-blue-100/80 text-sm font-medium mt-3">de experiencia</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════
             POR QUÉ CONTRATAR
        ══════════════════════════════════════ -->
        <section class="py-20 md:py-28 bg-white dot-grid">
            <div class="container-custom">
                <div class="max-w-xl mb-14 reveal">
                    <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight" style="text-wrap: balance;">
                        ¿Por qué contratar con Sistemas Virtuales?
                    </h2>
                    <p class="text-slate-500 text-base mt-4 leading-relaxed" style="text-wrap: pretty;">
                        Está comprobado por nuestros clientes que la tecnología de nuestros productos y servicios está a la altura de sus necesidades y lo más importante es que es algo totalmente personalizado para ti y tu flota vehicular.
                    </p>
                </div>

                <!-- Reasons: large text rows, not card grid -->
                <div class="flex flex-col divide-y divide-slate-100 reveal-stagger">
                    <div class="reason-row flex flex-col md:flex-row md:items-center gap-4 md:gap-10 py-8">
                        <span class="text-6xl font-black leading-none shrink-0 select-none w-16" style="color: rgba(0,89,166,0.14);">01</span>
                        <div class="flex flex-col gap-1">
                            <h3 class="text-xl font-bold text-slate-900">Personalización real</h3>
                            <p class="text-slate-500 leading-relaxed max-w-2xl">No adaptamos su empresa a nuestro software; adaptamos nuestras soluciones a su operación. Configuramos alertas, zonas, reportes y perfiles según el tipo de flota.</p>
                        </div>
                    </div>

                    <div class="reason-row flex flex-col md:flex-row md:items-center gap-4 md:gap-10 py-8">
                        <span class="text-6xl font-black leading-none shrink-0 select-none w-16" style="color: rgba(0,89,166,0.14);">02</span>
                        <div class="flex flex-col gap-1">
                            <h3 class="text-xl font-bold text-slate-900">Soporte humano y cercano</h3>
                            <p class="text-slate-500 leading-relaxed max-w-2xl">Nuestro equipo está disponible para acompañar a cada cliente. No tickets automáticos: personas reales que conocen su cuenta y responden cuando lo necesita.</p>
                        </div>
                    </div>

                    <div class="reason-row flex flex-col md:flex-row md:items-center gap-4 md:gap-10 py-8">
                        <span class="text-6xl font-black leading-none shrink-0 select-none w-16" style="color: rgba(0,89,166,0.14);">03</span>
                        <div class="flex flex-col gap-1">
                            <h3 class="text-xl font-bold text-slate-900">Tecnología de punta</h3>
                            <p class="text-slate-500 leading-relaxed max-w-2xl">Equipos GPS de alta precisión, cámaras IP vehiculares y residenciales, y software de administración remota actualizado constantemente para responder a las exigencias del mercado.</p>
                        </div>
                    </div>

                    <div class="reason-row flex flex-col md:flex-row md:items-center gap-4 md:gap-10 py-8">
                        <span class="text-6xl font-black leading-none shrink-0 select-none w-16" style="color: rgba(0,89,166,0.14);">04</span>
                        <div class="flex flex-col gap-1">
                            <h3 class="text-xl font-bold text-slate-900">Empresa legalmente constituida</h3>
                            <p class="text-slate-500 leading-relaxed max-w-2xl">Contamos con respaldo jurídico y operativo sólido. Sus datos, sus activos y su tranquilidad están en manos de una organización formal y responsable.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════
             MISIÓN + VISIÓN
        ══════════════════════════════════════ -->
        <section class="py-20 md:py-28" style="background-color: var(--surface-tint);">
            <div class="container-custom">
                <div class="grid md:grid-cols-2 gap-6 reveal-stagger">
                    <!-- Misión -->
                    <article class="bg-white border border-slate-200 rounded-3xl p-10 flex flex-col gap-5">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-2xl flex items-center justify-center shrink-0" style="background-color: #0059a6;">
                                <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                                </svg>
                            </div>
                            <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">Misión</h2>
                        </div>
                        <p class="text-slate-600 leading-relaxed text-base" style="text-wrap: pretty;">
                            SISTEMAS VIRTUALES ZONA ANDINA S.A.S. es una empresa privada, legalmente constituida, que brinda seguridad y tranquilidad a sus usuarios contando con las mejores herramientas tecnológicas para la administración remota de bienes móviles; con un equipo humano de alto nivel ético y profesional.
                        </p>
                    </article>

                    <!-- Visión -->
                    <article class="bg-[#003d73] rounded-3xl p-10 flex flex-col gap-5">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-2xl flex items-center justify-center shrink-0" style="background-color: rgba(255,212,0,0.15); border: 1px solid rgba(255,212,0,0.3);">
                                <svg class="w-5 h-5" style="color: #ffd400;" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </div>
                            <h2 class="text-2xl font-extrabold text-white tracking-tight">Visión</h2>
                        </div>
                        <p class="text-slate-300 leading-relaxed text-base" style="text-wrap: pretty;">
                            SISTEMAS VIRTUALES ZONA ANDINA S.A.S. será reconocida como una de las mejores empresas dedicada a la administración remota de activos móviles, garantizando calidad y confianza a nuestros usuarios a nivel nacional.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════════════════
             CTA
        ══════════════════════════════════════ -->
        <section class="py-20" style="background-color: #0059a6;">
            <div class="container-custom text-center reveal">
                <h2 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight mb-4" style="text-wrap: balance;">
                    ¿Listo para proteger tu flota?
                </h2>
                <p class="text-blue-100/90 text-lg mb-8 max-w-xl mx-auto" style="text-wrap: pretty;">
                    Hable con nuestro equipo y reciba una solución personalizada para su operación.
                </p>
                <div class="flex flex-wrap gap-4 justify-center">
                    <a
                        href="https://wa.me/573157003022"
                        target="_blank"
                        rel="noopener"
                        class="inline-flex items-center gap-2 px-8 py-4 bg-[#ffd400] text-[#003d73] font-bold rounded-full hover:bg-yellow-300 transition-colors duration-200"
                    >
                        Solicitar Demo
                        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
                        </svg>
                    </a>
                    <a
                        href="tel:3157003022"
                        class="inline-flex items-center gap-2 px-8 py-4 border-2 border-white/40 text-white font-bold rounded-full hover:bg-white/10 transition-colors duration-200"
                    >
                        315 700 3022
                    </a>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</MainLayout>

<script>
    /* ── Animated counters ─────────────────────────────────────── */
    function animateCounters() {
        const els = document.querySelectorAll<HTMLElement>(".stat-number");
        els.forEach((el) => {
            const target = parseFloat(el.dataset.target || "");
            if (isNaN(target)) return;

            const suffix = el.dataset.suffix ?? "";
            const duration = 1800;
            const steps = 60;
            const interval = duration / steps;
            let step = 0;

            const timer = setInterval(() => {
                step++;
                const progress = 1 - Math.pow(1 - step / steps, 3);
                const current = target * progress;
                const display =
                    target % 1 === 0
                        ? Math.round(current).toLocaleString()
                        : current.toFixed(1);
                el.innerHTML = display + suffix;

                if (step >= steps) {
                    clearInterval(timer);
                    el.innerHTML = el.dataset.raw!;
                }
            }, interval);
        });
    }

    const statsSection = document.querySelector(".stat-number")?.closest("section");
    if (statsSection) {
        const observer = new IntersectionObserver(
            (entries) => {
                if (entries[0].isIntersecting) {
                    animateCounters();
                    observer.disconnect();
                }
            },
            { threshold: 0.3 }
        );
        observer.observe(statsSection);
    }
</script>
