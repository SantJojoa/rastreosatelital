---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
    title="Cámaras Vehiculares con IA Dash Cam | Sistemas Virtuales"
    description="Dash Cam vehicular con grabación y transmisión de video en tiempo real. Analiza hábitos de conducción, identifica maniobras de riesgo y registra evidencias en la plataforma."
>
    <Header />

    <main>
        <!-- Hero -->
        <section class="bg-white pt-32 pb-20 md:pt-40 md:pb-28 relative overflow-hidden border-b border-slate-100">
            <div class="absolute inset-0 dot-grid opacity-60 pointer-events-none"></div>
            <div class="absolute top-1/2 right-0 w-[500px] h-[500px] rounded-full blur-3xl -translate-y-1/2 pointer-events-none" style="background-color: rgba(0,89,166,0.06);"></div>

            <div class="container-custom relative z-10 text-center">
                <div class="inline-flex items-center gap-2 mb-6 px-4 py-2 rounded-full" style="background-color: rgba(0,89,166,0.08); border: 1px solid rgba(0,89,166,0.2);">
                    <span class="w-1.5 h-1.5 rounded-full" style="background-color: #0059a6;"></span>
                    <span class="text-sm font-medium" style="color: #0059a6;">Video en tiempo real con IA</span>
                </div>
                <h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 tracking-tight mb-5" style="text-wrap: balance;">
                    Cámaras Vehiculares con IA Dash Cam
                </h1>
                <p class="text-slate-600 text-lg md:text-xl max-w-2xl mx-auto leading-relaxed">
                    Dash Cam vehicular con grabación y transmisión de video en tiempo real.
                </p>
            </div>
        </section>

        <!-- Dash Cam -->
        <section class="py-20 md:py-28 bg-white dot-grid">
            <div class="container-custom">
                <article class="group relative rounded-3xl overflow-hidden flex flex-col md:flex-row bg-white border border-slate-100 hover:-translate-y-1 hover:shadow-xl transition-all duration-300 reveal">
                    <div class="relative w-full md:w-2/5 h-56 md:h-auto overflow-hidden">
                        <img
                            src="/references/vehicles-cameras.webp"
                            alt="Dash Cam vehicular"
                            class="absolute inset-0 w-full h-full object-cover scale-105 group-hover:scale-110 transition-transform duration-500"
                        />
                        <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.05) 60%);"></div>
                        <span class="absolute top-5 left-5 px-3 py-1 rounded-full text-xs font-bold text-white shadow-md" style="background-color: #0059a6;">Dash Cam con IA</span>
                    </div>

                    <div class="relative z-10 p-8 flex flex-col gap-6 flex-1">
                        <div>
                            <h2 class="text-xl font-bold text-slate-900">Dash Cam Vehicular</h2>
                            <p class="font-medium text-sm mt-0.5" style="color: #0059a6;">Grabación y transmisión en tiempo real</p>
                        </div>

                        <div class="flex flex-col gap-2.5 flex-1">
                            {[
                                "Dash Cam vehicular con grabación y transmisión de video en tiempo real.",
                                "Analiza hábitos de conducción e identifica maniobras de riesgo.",
                                "Registra evidencias de infracciones y eventos en la plataforma.",
                                "Más seguridad vial, control y respaldo visual para la gestión de tu flota.",
                            ].map((item) => (
                                <div class="flex items-start gap-2.5 text-slate-600 text-sm">
                                    <span class="w-4 h-4 mt-0.5 rounded-full flex items-center justify-center shrink-0" style="background-color: rgba(0,89,166,0.1); border: 1px solid rgba(0,89,166,0.25);">
                                        <svg class="w-2.5 h-2.5" viewBox="0 0 12 12" fill="none" style="color: #0059a6;">
                                            <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </span>
                                    {item}
                                </div>
                            ))}
                        </div>

                        <a
                            href="https://wa.me/573157003022?text=Hola%2C%20me%20interesa%20informaci%C3%B3n%20sobre%20la%20Dash%20Cam%20vehicular."
                            target="_blank"
                            rel="noopener"
                            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-bold transition-colors duration-200 self-start"
                            style="background-color: #ffd400; color: #003d73;"
                        >
                            Solicitar información
                            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/></svg>
                        </a>
                    </div>
                </article>
            </div>
        </section>

        <!-- CTA -->
        <section class="py-16 border-t border-[rgba(0,89,166,0.08)]" style="background-color: var(--surface-tint);">
            <div class="container-custom text-center reveal">
                <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-3">¿Quieres una Dash Cam para tu flota?</h2>
                <p class="text-slate-500 mb-7 max-w-md mx-auto">Nuestro equipo le asesora sin costo y le recomienda la mejor solución para su operación.</p>
                <a
                    href="https://wa.me/573157003022"
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-2 px-8 py-4 bg-[#0059a6] text-white font-bold rounded-full hover:bg-[#004a8c] transition-colors duration-200"
                >
                    Asesoría gratuita por WhatsApp
                    <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
                    </svg>
                </a>
            </div>
        </section>
    </main>

    <Footer />
</MainLayout>
