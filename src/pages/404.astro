---
import "../styles/global.css";
---

<!doctype html>
<html lang="es" class="h-full">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Página no encontrada | Sistemas Virtuales</title>
        <link rel="icon" href="/logo.png" type="image/png" />
    </head>
    <body class="h-full bg-slate-950">
        <div class="min-h-[100dvh] flex flex-col relative overflow-hidden">

            <!-- Background grid -->
            <div class="absolute inset-0 pointer-events-none"
                style="background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px); background-size: 72px 72px;"
                aria-hidden="true">
            </div>

            <!-- Blue glow -->
            <div class="absolute -top-32 -right-32 w-[600px] h-[600px] rounded-full pointer-events-none"
                style="background: radial-gradient(circle, rgba(37,99,235,0.2) 0%, transparent 65%); filter: blur(40px);"
                aria-hidden="true">
            </div>

            <!-- Header -->
            <header class="relative z-10 flex items-center justify-between px-8 py-5 border-b border-white/[0.06] reveal">
                <img src="/logo.png" alt="Sistemas Virtuales"
                    class="h-8 w-auto object-contain brightness-0 invert opacity-75" />
                <a href="/"
                    class="inline-flex items-center gap-2 text-slate-400 hover:text-white text-sm font-medium transition-colors duration-150">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24"
                        stroke-width="2" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                    </svg>
                    Volver al inicio
                </a>
            </header>

            <!-- Main -->
            <main class="relative z-10 flex-1 grid grid-cols-1 lg:grid-cols-2 gap-8 items-center max-w-[1200px] w-full mx-auto px-8 py-12">

                <!-- Left: content -->
                <div>
                    <p class="font-mono text-xs font-medium text-blue-400 tracking-[0.18em] uppercase mb-5 reveal"
                        style="--i:1">
                        Error 404
                    </p>

                    <h1 class="text-[clamp(2.5rem,5vw,4rem)] font-extrabold text-white leading-[1.1] tracking-tight mb-5 reveal"
                        style="--i:2">
                        ¡Ups! Esta<br />pagina no<br />existe.
                    </h1>

                    <p class="text-base leading-relaxed text-slate-400 max-w-[36ch] mb-9 reveal"
                        style="--i:3">
                        No te preocupes, puede pasar. La pagina que buscas fue
                        movida o la URL esta incorrecta. Te ayudamos a
                        encontrar lo que necesitas.
                    </p>

                    <!-- Actions -->
                    <div class="flex flex-wrap gap-3 mb-10 reveal" style="--i:4">
                        <a href="/"
                            class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold rounded-lg active:scale-[0.98] transition-all duration-150">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24"
                                stroke-width="2" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                            </svg>
                            Ir al inicio
                        </a>

                        <a href="https://wa.me/573157003022" target="_blank" rel="noopener"
                            class="inline-flex items-center gap-2 px-5 py-2.5 bg-green-500/10 border border-green-500/25 hover:bg-green-500/20 text-green-400 text-sm font-semibold rounded-lg active:scale-[0.98] transition-all duration-150">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24"
                                fill="currentColor" aria-hidden="true">
                                <path
                                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                            </svg>
                            Hablar por WhatsApp
                        </a>
                    </div>

                    <!-- Quick links -->
                    <div class="flex flex-col gap-2.5 reveal" style="--i:5">
                        <span class="text-xs font-mono font-medium text-slate-600 uppercase tracking-[0.1em]">
                            Quizas buscabas:
                        </span>
                        <div class="flex flex-wrap gap-2">
                            {[
                                { label: "Servicios", href: "/planes#servicios" },
                                { label: "Nosotros", href: "/#nosotros" },
                                { label: "Contacto", href: "/#contacto" },
                            ].map((link) => (
                                <a href={link.href}
                                    class="inline-flex items-center px-3 py-1.5 bg-white/5 border border-white/[0.08] hover:bg-white/10 hover:border-white/15 hover:text-white text-slate-400 text-xs font-medium rounded-full transition-all duration-150">
                                    {link.label}
                                </a>
                            ))}
                        </div>
                    </div>
                </div>

                <!-- Right: big 404 -->
                <div class="hidden lg:flex flex-col items-center justify-center gap-4 reveal" style="--i:0"
                    aria-hidden="true">
                    <div class="relative flex items-center justify-center select-none">
                        <div class="absolute inset-[-20%] rounded-full pointer-events-none"
                            style="background: radial-gradient(circle, rgba(37,99,235,0.28) 0%, transparent 70%); filter: blur(30px);">
                        </div>
                        <span class="relative text-[clamp(8rem,18vw,16rem)] font-black leading-none tracking-[-0.04em]"
                            style="background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0.03) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; -webkit-text-stroke: 1.5px rgba(255,255,255,0.09);">
                            404
                        </span>
                    </div>
                    <p class="text-xs font-medium text-white/20 tracking-[0.18em] uppercase">
                        Pagina no encontrada
                    </p>
                </div>
            </main>

            <!-- Footer -->
            <footer class="relative z-10 flex items-center justify-between px-8 py-4 border-t border-white/[0.06] text-xs text-slate-600 reveal"
                style="--i:6">
                <span>sistemasvirtualesltda.com</span>
                <span>315 700 3022</span>
            </footer>
        </div>

        <style>
            .reveal {
                opacity: 0;
                transform: translateY(14px);
                animation: revealUp 650ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
                animation-delay: calc(var(--i, 0) * 80ms + 60ms);
            }
            @keyframes revealUp {
                to { opacity: 1; transform: translateY(0); }
            }
            @media (prefers-reduced-motion: reduce) {
                .reveal { animation: none; opacity: 1; transform: none; }
            }
        </style>
    </body>
</html>
